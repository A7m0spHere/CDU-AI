---
import { drawLibrary, libraryInitialView } from '../lib/library-model';

const drawing = drawLibrary(libraryInitialView.yaw, libraryInitialView.pitch);
---

<div class="cdu-library" data-library>
  <div class="cdu-library__viewer" data-library-viewer role="img" aria-label="成都大学图书馆线稿">
    <svg
      class="cdu-library-line-art"
      data-library-line-art
      viewBox="0 0 1000 560"
      preserveAspectRatio="xMidYMid meet"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <clipPath id="cdu-library-portal-clip">
          <path d={drawing.portal} data-library-clip />
        </clipPath>
      </defs>
      {drawing.groups.map(group => (
        <g
          data-library-group={group.id}
          data-library-door={group.id.startsWith('door-') ? group.id.slice(5) : undefined}
          stroke-width={group.width}
          opacity={group.opacity}
          visibility={group.visible ? 'visible' : 'hidden'}
          clip-path={group.clipped ? 'url(#cdu-library-portal-clip)' : undefined}
        >
          {group.paths.map(path => <path d={path} />)}
        </g>
      ))}
    </svg>
  </div>
  <p id="library-help" class="sr-only">左右方向键旋转，上下方向键调整俯角，Home 键恢复默认视角。</p>
</div>

<script>
  import '../scripts/library-viewer';
</script>
