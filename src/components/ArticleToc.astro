---
import Icon from './Icon.astro';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const headings = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{headings.length > 0 && (
  <nav class="wiki-toc" aria-label="本页目录">
    <p class="wiki-toc__label" aria-hidden="true">本页目录</p>
    <ol>
      {headings.map(({ depth, slug, text }) => (
        <li class:list={{ 'wiki-toc__depth-3': depth === 3 }}>
          <a href={`#${encodeURIComponent(slug)}`}>{text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

{headings.length >= 2 && (
  <>
    <button
      class="toc-fab"
      type="button"
      data-toc-open
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="mobile-toc-sheet"
    >
      <Icon name="layers" size={15} />
      <span>本页小节</span>
    </button>

    <dialog class="toc-sheet" id="mobile-toc-sheet" data-toc-sheet aria-labelledby="toc-sheet-title">
      <div class="toc-sheet__inner">
        <div class="toc-sheet__head">
          <h2 id="toc-sheet-title">本页小节</h2>
          <button class="toc-sheet__close" type="button" data-toc-close aria-label="关闭本页小节">
            <Icon name="close" size={18} />
          </button>
        </div>
        <nav class="toc-sheet__nav" aria-label="本页小节跳转">
          <ol>
            {headings.map(({ depth, slug, text }) => (
              <li class:list={{ 'toc-sheet__depth-3': depth === 3 }}>
                <a href={`#${encodeURIComponent(slug)}`} data-toc-link>{text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </dialog>
  </>
)}
