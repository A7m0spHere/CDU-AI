---
import { site, navItems, repository } from '../data/site';
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
import ThemePicker from './ThemePicker.astro';

const rawPath = Astro.url.pathname;
const currentPath = rawPath.endsWith('/') ? rawPath : rawPath + '/';

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(href);
}
---

<header class="site-header" data-site-header data-scrolled="false">
  <div class="container header-inner">
    <a class="brand" href="/">
      <LogoMark />
      <span class="brand-text">
        <strong>{site.name}</strong>
        <small>{site.englishName}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {navItems.map((item) => (
        <a
          class="nav-link"
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a class="nav-cta" href="/about/">关于与共建</a>
    </nav>

    <div class="header-actions">
      <button class="search-trigger" type="button" data-search-open>
        <Icon name="search" size={16} />
        <span class="search-trigger__label">搜索指南、术语、工具或作品</span>
        <span class="sr-only">打开站内搜索</span>
        <kbd class="search-trigger__kbd" aria-hidden="true">Ctrl K</kbd>
      </button>

      <ThemePicker />

      <a
        class="icon-button header-github"
        href={repository.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub 仓库（在新标签页打开）"
        title="在 GitHub 上查看与共建"
      >
        <Icon name="github" size={18} />
      </a>

      <details class="mobile-menu" data-mobile-menu>
        <summary class="icon-button" aria-label="打开导航菜单">
          <Icon name="menu" size={20} />
        </summary>
        <div class="mobile-menu__panel">
          <nav aria-label="移动端导航">
            <div class="mobile-nav-list">
              {navItems.map((item) => (
                <a
                  class="mobile-nav-link"
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  <span>
                    <span class="mobile-nav-link__label">{item.label}</span>
                    <span class="mobile-nav-link__desc">{item.description}</span>
                  </span>
                  <Icon name="chevron-right" size={16} />
                </a>
              ))}
            </div>
          </nav>
          <div class="mobile-menu__cta">
            <a class="btn btn--primary" href="/guide/">
              从零开始学习
              <Icon name="arrow-right" size={16} />
            </a>
            <a class="btn btn--ghost" href="/about/">关于与共建</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>