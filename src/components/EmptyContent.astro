---
import Icon from './Icon.astro';

interface Props {
  icon?: 'sprout' | 'book-open' | 'wrench' | 'spark' | 'users' | 'search' | 'info';
  title: string;
  description: string;
  links?: { label: string; href: string; external?: boolean }[];
  /** 空状态上方的小标签，默认「内容准备中」 */
  status?: string;
}

const { icon = 'sprout', title, description, links = [], status = '内容准备中' } = Astro.props;
---

<div class="empty-state empty-state--v2 content-empty" data-content-empty role="status">
  <span class="empty-state__icon" aria-hidden="true"><Icon name={icon} size={24} /></span>
  <p class="empty-state__eyebrow">{status}</p>
  <h2>{title}</h2>
  <p>{description}</p>
  {links.length > 0 && (
    <div class="btn-row">
      {links.map((link) => (
        <a
          class="btn btn--soft btn--sm"
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
          <Icon name={link.external ? 'arrow-up-right' : 'arrow-right'} size={14} />
        </a>
      ))}
    </div>
  )}
</div>

<style>
  .content-empty {
    margin-top: 1.8rem;
  }

  .content-empty .btn-row {
    justify-content: center;
    margin-top: 1.2rem;
  }
</style>
