---
import type { Tool } from '../data/types';
import Icon from './Icon.astro';
import { toolBasisLabels, toolCapabilities } from '../data/tools';

interface Props {
  tool: Tool;
  categoryLabel: string;
  /** 是否渲染在默认收起的区域：只作为标记，展开/收起由页面上的 <details> 控制。 */
  collapsed?: boolean;
}

const { tool, categoryLabel, collapsed = false } = Astro.props;

const toneByCategory: Record<string, string> = {
  'llm-chat': 'sage',
  agent: 'violet',
  image: 'rose',
  video: 'rose',
  tts: 'sky',
  stt: 'sky',
  music: 'sand',
  research: 'sky',
  workflow: 'violet',
  local: 'sage',
  community: 'sky',
  api: 'violet',
  compute: 'sky',
};

const tone = toneByCategory[tool.category] ?? 'sage';
const initial = tool.name.trim().slice(0, 1).toUpperCase();
const capabilityLabels = toolCapabilities.filter((cap) => tool.capabilities.includes(cap.id)).map((cap) => cap.label);
// 搜索框匹配的范围：名称、别名、技术类型、形态、分类、能力与标签。
const searchText = [
  tool.name,
  ...(tool.aliases ?? []),
  tool.summary,
  tool.description,
  tool.bestFor,
  tool.tech,
  tool.kind,
  categoryLabel,
  ...(tool.alsoIn ?? []).map((id) => (id === 'workflow' ? '工作流' : id)),
  ...capabilityLabels,
  ...tool.tags,
]
  .join(' ')
  .toLowerCase();
const basisLabel = toolBasisLabels[tool.basis] ?? '官网核对';
// GitHub 也承载 Copilot 等产品官网；只有官网入口与仓库入口相同时才按仓库展示。
const isRepositoryUrl = Boolean(
  tool.githubUrl && new URL(tool.url).href.replace(/\/$/, '') === new URL(tool.githubUrl).href.replace(/\/$/, ''),
);
const githubUrl = tool.githubUrl;
---

<article
  class="tool-card card"
  data-filter-card
  data-tool-id={tool.id}
  data-category={[tool.category, ...(tool.alsoIn ?? [])].join(' ')}
  data-capabilities={tool.capabilities.join(' ')}
  data-search={searchText}
  data-collapsed={collapsed ? 'true' : undefined}
>
  <div class="tool-card__top">
    <span class={tool.logo ? `tool-mark tool-mark--logo` : `tool-mark tool-mark--${tone}`}>
      {tool.logo ? (
        <>
          {/* 首字母只在图标加载失败时出现：默认隐藏，避免透底后字母从透明区域露出来 */}
          <span class="tool-mark__fallback" aria-hidden="true" data-fallback hidden>{initial}</span>
          <img
            class="tool-mark__img"
            src={tool.logo.src}
            alt=""
            loading="lazy"
            decoding="async"
            data-mono={tool.logo.mono ? 'true' : undefined}
            onerror="var fb = this.parentElement?.querySelector('[data-fallback]'); this.remove(); if (fb) fb.hidden = false;"
          />
        </>
      ) : (
        <span class="tool-mark__fallback" aria-hidden="true">{initial}</span>
      )}
    </span>
    <div class="tool-card__identity">
      <h3>
        <a href={tool.url} target="_blank" rel="noopener noreferrer">
          {tool.name}
          <Icon name="external-link" size={15} />
        </a>
      </h3>
      <p>{tool.kind} · {tool.tech}</p>
    </div>
    {tool.featured && <span class="badge badge--brand">新手先试</span>}
  </div>

  <p class="tool-card__summary">{tool.summary}</p>

  <div class="tool-card__best">
    <span>适合</span>
    {tool.bestFor}
  </div>

  <div class="tool-card__meta">
    {tool.pricing && <span class="badge">{tool.pricing}</span>}
    <span class="badge">{tool.difficulty}</span>
    <span class="tool-card__category">{categoryLabel}</span>
  </div>

  <details class="tool-card__details">
    <summary>展开细节</summary>
    <p class="tool-card__description">{tool.description}</p>
    <ul class="tag-list" aria-label="标签">
      {capabilityLabels.map((label) => <li class="tag tag--cap">{label}</li>)}
      {tool.tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    {tool.caution && (
      <p class="tool-card__caution">
        <Icon name="alert-triangle" size={14} />
        {tool.caution}
      </p>
    )}
    <p class="tool-card__verify">
      核验 {tool.verifiedOn} · {basisLabel}
      {tool.logo && <span class="tool-card__logo-src">图标：{tool.logo.source}</span>}
    </p>
  </details>

  <div class="tool-card__foot">
    {!isRepositoryUrl && (
      <a class="link-arrow" href={tool.url} target="_blank" rel="noopener noreferrer">
        打开官网
        <Icon name="arrow-up-right" size={15} />
      </a>
    )}
    {githubUrl && (
      <a class="tool-card__repo" href={githubUrl} target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={15} />
        代码仓库
      </a>
    )}
  </div>
</article>
