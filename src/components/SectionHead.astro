---
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  titleLines?: string[];
  description?: string;
  link?: string;
  linkLabel?: string;
  centered?: boolean;
  id?: string;
  /** 区块编号（如 01），用于首页编辑式分区。 */
  index?: string;
  /** 提供给 <h2> 的 id，便于 section 的 aria-labelledby 引用。 */
  headingId?: string;
}

const {
  eyebrow,
  title,
  titleLines,
  description,
  link,
  linkLabel = '查看全部',
  centered = false,
  id,
  index,
  headingId,
} = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': centered }]} id={id}>
  <div class="section-head__copy">
    {(eyebrow || index) && (
      <p class="eyebrow section-head__eyebrow">
        {index && <span class="section-head__index mono">{index}</span>}
        {eyebrow && <span>{eyebrow}</span>}
      </p>
    )}
    <h2 id={headingId}>
      {titleLines && titleLines.length > 0
        ? titleLines.map((line, index) => (
            <Fragment>
              {line}
              {index < titleLines.length - 1 && <br class="title-br" />}
            </Fragment>
          ))
        : title}
    </h2>
    {description && <p class="section-head__desc">{description}</p>}
  </div>
  {link && (
    <a class="link-arrow section-head__link" href={link}>
      {linkLabel}
      <Icon name="arrow-right" size={16} />
    </a>
  )}
</div>
