---
import BaseLayout from './BaseLayout.astro';
import DocsNav from '../components/DocsNav.astro';
import DocsNewMenu from '../components/DocsNewMenu.astro';
import Icon from '../components/Icon.astro';
import { docsPages, githubEditFile, githubHistoryFile } from '../data/docs';
import '../styles/docs.css';

interface Props {
  current: string;
}

const { current } = Astro.props;
const page = docsPages.find((item) => item.id === current);

if (!page) {
  throw new Error('Docs page not found: ' + current);
}

const editUrl = githubEditFile(page.sourcePath);
const historyUrl = githubHistoryFile(page.sourcePath);
---

<BaseLayout title={page.title} description={page.description}>
  <div class="docs-app-shell">
    <div class="container docs-app">
      <aside class="docs-sidebar" aria-label="团队文档">
        <a class="docs-workspace" href="/docs/">
          <span class="docs-workspace__icon" aria-hidden="true">📚</span>
          <span class="docs-workspace__copy">
            <strong>CDU-AI 文档</strong>
            <small>公开协作空间</small>
          </span>
        </a>

        <div class="docs-sidebar__new">
          <DocsNewMenu />
        </div>

        <DocsNav current={current} />
      </aside>

      <div class="docs-stage">
        <details class="docs-mobile-nav" data-docs-menu>
          <summary>
            <span class="docs-mobile-nav__label"><span aria-hidden="true">☰</span> 文档目录</span>
            <span class="docs-mobile-nav__page">{page.title}</span>
          </summary>
          <div class="docs-mobile-nav__panel">
            <DocsNav current={current} />
            <DocsNewMenu />
          </div>
        </details>

        <article class="docs-page">
          <header class="docs-page__header">
            <div class="docs-page__heading">
              <span class="docs-page__emoji" aria-hidden="true">{page.emoji}</span>
              <div>
                <nav class="docs-breadcrumb" aria-label="面包屑">
                  <a href="/docs/">文档</a>
                  <span class="docs-breadcrumb__sep" aria-hidden="true">/</span>
                  <span>{page.group}</span>
                </nav>
                <h1>{page.title}</h1>
              </div>
            </div>

            <details class="docs-actions" data-docs-menu>
              <summary aria-label="页面操作" title="页面操作"><span aria-hidden="true">⋯</span></summary>
              <div class="docs-menu docs-actions__menu">
                <p class="docs-menu__label">页面操作</p>
                <a href={editUrl} target="_blank" rel="noopener noreferrer">
                  <Icon name="pen" size={14} />
                  在 GitHub 编辑本页
                  <Icon name="arrow-up-right" size={13} />
                </a>
                <a href={historyUrl} target="_blank" rel="noopener noreferrer">
                  <Icon name="clock" size={14} />
                  查看提交历史
                  <Icon name="arrow-up-right" size={13} />
                </a>
                <a href="/docs/workflow/">
                  <Icon name="book-open" size={14} />
                  如何新建内容
                  <Icon name="chevron-right" size={13} />
                </a>
              </div>
            </details>
          </header>

          <p class="docs-page__desc">{page.description}</p>

          <div class="docs-page__meta">
            <span>最后更新：{page.updated}</span>
            <span>{page.group} · 公开文档</span>
          </div>

          <div class="docs-content">
            <slot />
          </div>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/docs';
</script>
