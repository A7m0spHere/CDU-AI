---
import BaseLayout from './BaseLayout.astro';
import GuideSidebar from '../components/GuideSidebar.astro';
import GuideMobileNav from '../components/GuideMobileNav.astro';
import DocsNewMenu from '../components/DocsNewMenu.astro';
import Icon from '../components/Icon.astro';
import { docsPages, githubEditFile, githubHistoryFile } from '../data/docs';
import '../styles/docs.css';

interface Props {
  current: string;
}

const { current } = Astro.props;
const pageIndex = docsPages.findIndex((item) => item.id === current);
const page = docsPages[pageIndex];

if (!page) {
  throw new Error('Docs page not found: ' + current);
}

const editUrl = githubEditFile(page.sourcePath);
const historyUrl = githubHistoryFile(page.sourcePath);
const previous = pageIndex > 0 ? docsPages[pageIndex - 1] : undefined;
const next = pageIndex < docsPages.length - 1 ? docsPages[pageIndex + 1] : undefined;
---

<BaseLayout title={page.title} description={page.description}>
  <div class="wiki-shell">
    <div class="container wiki-layout wiki-layout--article">
      <GuideSidebar currentDoc={current} />

      <div class="wiki-main wiki-article guide-doc-main">
        <GuideMobileNav currentDoc={current} />

        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/">首页</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <a href="/guide/">学习指南</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <a href="/guide/docs/">团队文档</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <span aria-current="page">{page.title}</span>
        </nav>

        <header class="guide-doc-heading">
          <span class="guide-doc-heading__icon" aria-hidden="true">
            <Icon name={page.icon} size={22} />
          </span>
          <div class="guide-doc-heading__copy">
            <p class="eyebrow">学习指南 · 团队文档 · {page.group}</p>
            <h1>{page.title}</h1>
            <p class="wiki-lede">{page.description}</p>
          </div>

          <div class="guide-doc-heading__actions">
            <DocsNewMenu />

            <details class="docs-actions" data-docs-menu>
              <summary aria-label="页面操作" title="页面操作">
                <Icon name="more-horizontal" size={17} />
              </summary>
              <div class="docs-menu docs-actions__menu">
                <p class="docs-menu__label">页面操作</p>
                <a href={editUrl} target="_blank" rel="noopener noreferrer">
                  <Icon name="pen" size={14} />
                  在 GitHub 编辑本页
                  <Icon name="arrow-up-right" size={13} />
                </a>
                <a href={historyUrl} target="_blank" rel="noopener noreferrer">
                  <Icon name="clock" size={14} />
                  查看提交历史
                  <Icon name="arrow-up-right" size={13} />
                </a>
                <a href="/guide/docs/workflow/">
                  <Icon name="book-open" size={14} />
                  如何新建内容
                  <Icon name="chevron-right" size={13} />
                </a>
              </div>
            </details>
          </div>
        </header>

        <div class="guide-doc-content docs-content">
          <slot />
        </div>

        <div class="page-meta">
          <span><Icon name="clock" size={14} />最后更新：{page.updated}</span>
          <a href={editUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="pen" size={14} />在 GitHub 编辑本页
            <Icon name="arrow-up-right" size={13} />
          </a>
        </div>

        <nav class="wiki-pager guide-doc-pager" aria-label="团队文档翻页">
          {previous ? (
            <a class="wiki-pager__link" href={previous.href}>
              <span>上一篇文档</span>
              <strong>{previous.title}</strong>
            </a>
          ) : (
            <a class="wiki-pager__link" href="/guide/">
              <span>返回</span>
              <strong>学习指南首页</strong>
            </a>
          )}
          {next ? (
            <a class="wiki-pager__link wiki-pager__link--next" href={next.href}>
              <span>下一篇文档</span>
              <strong>{next.title}</strong>
            </a>
          ) : (
            <a class="wiki-pager__link wiki-pager__link--next" href="/guide/docs/">
              <span>继续</span>
              <strong>团队文档概览</strong>
            </a>
          )}
        </nav>
      </div>

      <aside class="wiki-toc guide-doc-aside" aria-label="文档信息">
        <p class="wiki-toc__label">文档信息</p>
        <dl class="guide-doc-aside__meta">
          <div><dt>分组</dt><dd>{page.group}</dd></div>
          <div><dt>更新</dt><dd>{page.updated}</dd></div>
          <div><dt>范围</dt><dd>公开协作文档</dd></div>
        </dl>
        <div class="guide-doc-aside__links">
          <a href={editUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="pen" size={13} />在 GitHub 编辑本页
          </a>
          <a href={historyUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="clock" size={13} />查看提交历史
          </a>
        </div>
        <p class="guide-doc-aside__note">
          团队文档是学习指南的一部分：计划、任务与协作记录都在这里维护。新增文档或调整层级时，同步更新侧栏与文档数据。
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/docs';
</script>