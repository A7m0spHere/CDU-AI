---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { site } from '../data/site';
import { presetThemes } from '../data/themes';
import { resolveThemeVars } from '../lib/theme-core';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  noIndex?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  noIndex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;

/* 预设主题在构建期解析为变量表，供首屏防闪烁脚本直接应用 */
const bootPresets = presetThemes.map((preset) => ({
  id: preset.id,
  base: preset.params.base,
  vars: resolveThemeVars(preset.params),
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.organizer} />
    {noIndex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <noscript>
      <style>
        .search-trigger,
        .theme-picker {
          display: none !important;
        }
      </style>
    </noscript>

    <script is:inline define:vars={{ bootPresets }}>
      (() => {
        const root = document.documentElement;
        try {
          const saved = localStorage.getItem('cdu-ai-theme');
          let theme = null;
          if (saved && saved !== 'light' && saved !== 'dark') {
            if (saved.indexOf('preset-') === 0) {
              theme = bootPresets.find((item) => item.id === saved) || null;
            } else {
              const list = JSON.parse(localStorage.getItem('cdu-ai-custom-themes') || '[]');
              theme = Array.isArray(list)
                ? list.find((item) => item && item.id === saved && item.params) || null
                : null;
            }
          }
          if (theme) {
            const base = theme.base || (theme.params && theme.params.base);
            root.dataset.theme = base === 'dark' ? 'dark' : 'light';
            const vars = theme.vars || {};
            for (const key in vars) root.style.setProperty(key, vars[key]);
            /* 图片生效标记：让导航栏 / 画布层在首屏就为图片让位 */
            root.dataset.imageBg = String(vars['--page-bg-image'] || '').indexOf('url(') > -1 ? 'true' : 'false';
          } else {
            root.dataset.theme =
              saved === 'light' || saved === 'dark'
                ? saved
                : window.matchMedia('(prefers-color-scheme: dark)').matches
                  ? 'dark'
                  : 'light';
            root.dataset.imageBg = 'false';
          }
        } catch {
          root.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header />
    <SearchDialog />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/global';
      import '../scripts/motion';
    </script>
  </body>
</html>