---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDock from '../components/MobileDock.astro';
import SearchDialog from '../components/SearchDialog.astro';
import CursorGlow from '../components/CursorGlow.astro';
import CursorTrail from '../components/CursorTrail.astro';
import { site } from '../data/site';
import { presetThemes } from '../data/themes';
import { resolveThemeVars } from '../lib/theme-core';
import '../styles/global.css';
import '../styles/cursor-glow.css';
import '../styles/cursor-trail.css';
import '../styles/hover-glow.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  noIndex?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  noIndex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const canonicalUrl = !noIndex && Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : null;

/* 预设主题在构建期解析为变量表，供首屏防闪烁脚本直接应用 */
const bootPresets = presetThemes.map((preset) => ({
  id: preset.id,
  base: preset.params.base,
  vars: resolveThemeVars(preset.params),
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.organizer} />
    {noIndex && <meta name="robots" content="noindex, follow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <noscript>
      <style>
        .search-trigger,
        .mobile-dock__search,
        .home-mobile-search,
        .theme-picker {
          display: none !important;
        }
      </style>
    </noscript>

    <script is:inline define:vars={{ bootPresets }}>
      (() => {
        const root = document.documentElement;
        // 鼠标光效 / 光效拖尾默认关闭，仅在用户显式开启（存储值为 'on'）时首屏启用，避免刷新闪烁
        try {
          root.dataset.glow = localStorage.getItem('cdu-ai-glow') === 'on' ? 'on' : 'off';
          root.dataset.trail = localStorage.getItem('cdu-ai-trail') === 'on' ? 'on' : 'off';
        } catch {
          root.dataset.glow = 'off';
          root.dataset.trail = 'off';
        }
        try {
          const saved = localStorage.getItem('cdu-ai-theme');
          let theme = null;
          if (saved && saved !== 'light' && saved !== 'dark') {
            if (saved.indexOf('preset-') === 0) {
              theme = bootPresets.find((item) => item.id === saved) || null;
            } else {
              const list = JSON.parse(localStorage.getItem('cdu-ai-custom-themes') || '[]');
              theme = Array.isArray(list)
                ? list.find((item) => item && item.id === saved && item.params) || null
                : null;
            }
          }
          if (theme) {
            const base = theme.base || (theme.params && theme.params.base);
            root.dataset.theme = base === 'dark' ? 'dark' : 'light';
            const vars = theme.vars || {};
            for (const key in vars) root.style.setProperty(key, vars[key]);
            /* 沉浸背景标记：图片（含 url 层）或场景（--bg-scene） */
            const scene = vars['--bg-scene'] || '';
            root.dataset.bgScene = scene;
            root.dataset.imageBg =
              String(vars['--page-bg-image'] || '').indexOf('url(') > -1 || scene ? 'true' : 'false';
            /* 用户导入的字体：尽早注册，减少字体闪烁 */
            const font = theme.params && theme.params.font;
            if (font && font.preset === 'custom' && font.name && font.src) {
              try {
                const face = new FontFace(font.name, 'url("' + font.src + '")');
                face.load().then(function (loaded) { document.fonts.add(loaded); }).catch(function () {});
              } catch {}
            }
          } else {
            root.dataset.theme =
              saved === 'light' || saved === 'dark'
                ? saved
                : window.matchMedia('(prefers-color-scheme: dark)').matches
                  ? 'dark'
                  : 'light';
            root.dataset.imageBg = 'false';
          }
        } catch {
          root.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header />
    <SearchDialog />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileDock />
    <CursorGlow />
    <CursorTrail />
    <script>
      import '../scripts/global';
      import '../scripts/motion';
    </script>
  </body>
</html>