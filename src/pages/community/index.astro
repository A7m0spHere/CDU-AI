---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/routes/community.css';
import Icon from '../../components/Icon.astro';
---

<BaseLayout title="社区暂不开放" description="CDU AI 社区功能暂未开放。">
  <section class="section community-closed" aria-labelledby="community-closed-title">
    <div class="container community-closed__inner">
      <p class="eyebrow">社区</p>
      <h1 id="community-closed-title">社区暂不开放</h1>
      <p class="community-closed__desc">交流区目前未开放注册、发帖或评论。开放时间确定后会在这里公布。</p>
      <div class="notice community-closed__notice">
        <Icon name="info" size={17} />
        <p>本页暂无内容。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .community-closed__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 46rem;
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .community-closed h1 {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.03em;
  }

  .community-closed__desc {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.9;
  }

  .community-closed__notice {
    margin-top: 2rem;
  }
</style>
