---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideSidebar from '../../components/GuideSidebar.astro';
import GuideMobileNav from '../../components/GuideMobileNav.astro';
import GuidePager from '../../components/GuidePager.astro';
import { Content as GuideHomeContent } from '../../content/guide/_HOME.md';
import '../../styles/notion.css';
---

<BaseLayout title="欢迎来到 CDU AI" description="AI 学习指南。">
  <script is:inline>
    const guideIllustrationMode = new URLSearchParams(window.location.search).get('illustrations');
    document.documentElement.dataset.guideIllustrations =
      guideIllustrationMode === 'off' || guideIllustrationMode === 'single' ? guideIllustrationMode : 'on';
  </script>
  <div class="wiki-shell guide-doc-shell">
    <div class="container guide-doc-layout">
      <GuideSidebar />

      <div class="guide-paper guide-paper--index guide-home-paper notion-page">
        <div class="wiki-main">
          <GuideMobileNav />
          <article class="prose wiki-prose notion-prose guide-home-prose" aria-label="指南首页正文" data-guide-home-content>
            <GuideHomeContent />
          </article>
          <GuidePager />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .guide-home-prose {
    max-width: 48rem;
    color: var(--notion-ink-soft);
    line-height: 1.9;
  }

  .guide-home-prose :global(h1),
  .guide-home-prose :global(h2) {
    color: var(--notion-ink);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .guide-home-prose :global(h1) {
    margin: 0 0 1.25rem;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
  }

  .guide-home-prose :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .guide-home-prose :global(strong) {
    color: var(--notion-ink);
    font-weight: 700;
  }

  .guide-home-prose :global(em) {
    color: inherit;
    font-style: italic;
  }

  .guide-home-prose :global(.guide-home-illustration) {
    margin: 1.75rem 0;
  }

  .guide-home-prose :global(.guide-home-illustration img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border: 0;
    border-radius: 8px;
  }

  :global(html[data-guide-illustrations='off']) .guide-home-prose :global(.guide-home-illustration) {
    display: none;
  }

  :global(html[data-guide-illustrations='single']) .guide-home-prose :global(.guide-home-illustration--model) {
    display: none;
  }
</style>
