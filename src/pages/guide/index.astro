---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import GuideSidebar from '../../components/GuideSidebar.astro';
import GuideMobileNav from '../../components/GuideMobileNav.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyContent from '../../components/EmptyContent.astro';
import { guideStages, repository } from '../../data/site';
import '../../styles/notion.css';

const modules = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
const slugOf = (id: string) => id.replace(/\.md$/, '');
const groupedStages = guideStages.map((stage) => ({
  ...stage,
  modules: modules.filter((module) => module.data.stage === stage.id).sort((a, b) => a.data.order - b.data.order),
}));
const firstModule = modules[0];
const guideEmpty = modules.length === 0;
const contributeLinks = [
  { label: '投稿真实经验', href: `${repository.url}/issues/new?template=experience-submission.yml`, external: true },
  { label: '贡献指南', href: `${repository.url}/blob/main/CONTRIBUTING.md`, external: true },
];
---

<BaseLayout
  title="学习指南"
  description="面向所有专业同学的 AI 学习路线：先看清 AI 能做什么，再动手做一件小事，最后把过程整理出来。"
>
  <div class="wiki-shell guide-doc-shell">
    <div class="container guide-doc-layout">
      <GuideSidebar />

      <div class="guide-paper guide-paper--index">
        <div class="wiki-main">
        <GuideMobileNav />

        <PageHeader
          bare
          index="01"
          eyebrow="学习指南"
          title="AI 学习指南"
          lede="不必先懂编程。先看清 AI 能做什么，再动手完成一件小事，最后把过程整理成可以分享的经验。可以顺着读，也可以从眼下需要的一篇开始。"
          meta={[
            { label: guideEmpty ? '内容重建中' : modules.length + ' 篇', tone: guideEmpty ? 'warn' : 'brand' },
            { label: '3 个阶段' },
          ]}
          crumbs={[{ label: '学习指南' }]}
        />

        <div class="wiki-note">
          <Icon name="shield-check" size={17} />
          <p>开始前：AI 会出错，结论自己核对；不上传个人隐私；作业与论文按课程规则声明 AI 使用。</p>
        </div>

        {guideEmpty && (
          <EmptyContent
            icon="book-open"
            title="指南内容正在准备中"
            description="第一批学习指南正在撰写与人工核校中；每篇内容都会标注实际审校状态。想先贡献一篇真实经验，可以从经验投稿开始。"
            links={contributeLinks}
          />
        )}

        <section class="wiki-section" aria-labelledby="start-title" data-reveal>
          <h2 id="start-title">从哪里开始</h2>
          <div class="wiki-table-wrap">
            <table class="wiki-table">
              <thead>
                <tr><th scope="col">如果你想……</th><th scope="col">可以看</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td>第一次接触 AI</td>
                  <td><a href="#stage-start">先建立判断<Icon name="arrow-right" size={14} /></a></td>
                </tr>
                <tr>
                  <td>想动手做一个实际的小东西</td>
                  <td><a href="#stage-make">动手做出东西<Icon name="arrow-right" size={14} /></a></td>
                </tr>
                <tr>
                  <td>想整理作品与经验</td>
                  <td><a href="#stage-share">整理与分享<Icon name="arrow-right" size={14} /></a></td>
                </tr>
                <tr>
                  <td>想先找一个能用的工具</td>
                  <td><a href="/tools/">AI 工具资源<Icon name="arrow-right" size={14} /></a></td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="wiki-section wiki-outline" aria-labelledby="outline-title" data-reveal>
          <h2 id="outline-title">学习路线</h2>

          {groupedStages.map((stage) => (
            <section class="wiki-stage" id={`stage-${stage.id}`} aria-labelledby={`stage-${stage.id}-title`}>
              <header class="wiki-stage__head">
                <div class="wiki-stage__index mono">{stage.index}</div>
                <div>
                  <p class="eyebrow">{stage.label}</p>
                  <h2 id={`stage-${stage.id}-title`}>{stage.title}</h2>
                  <p>{stage.description}</p>
                </div>
              </header>

              {stage.modules.length > 0 ? (
                <ol class="wiki-module-list">
                  {stage.modules.map((module) => (
                    <li>
                      <a href={`/guide/${slugOf(module.id)}/`}>
                        <span class="mono">{String(module.data.order).padStart(2, '0')}</span>
                        <span class="wiki-module-list__title">{module.data.title}</span>
                        <Icon name="arrow-right" size={15} />
                      </a>
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="wiki-stage__empty">这一阶段的指南正在准备中。</p>
              )}
            </section>
          ))}
        </section>

        <div class="wiki-next">
          <div>
            <p class="eyebrow">下一步</p>
            <h2>{firstModule ? '从第一篇开始' : '内容准备中'}</h2>
            <p>{firstModule ? '先建立判断，再决定要不要把任务交给 AI。' : '第一批指南正在撰写；也可以先浏览工具资源与术语表，或参与共建。'}</p>
          </div>
          <div class="btn-row">
            {firstModule ? (
              <a class="btn btn--primary" href={`/guide/${slugOf(firstModule.id)}/`}>
                阅读第一篇
                <Icon name="arrow-right" size={16} />
              </a>
            ) : (
              <a class="btn btn--primary" href="/about/#contribute">
                参与共建
                <Icon name="arrow-right" size={16} />
              </a>
            )}
            <a class="btn btn--soft" href="/tools/">浏览工具</a>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .wiki-stage__empty {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
</style>