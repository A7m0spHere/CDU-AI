---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideHeading from '../../components/GuideHeading.astro';
import GuideSidebar from '../../components/GuideSidebar.astro';
import GuideMobileNav from '../../components/GuideMobileNav.astro';
import GuidePager from '../../components/GuidePager.astro';
import { Content as GuideHomeContent, frontmatter } from '../../content/guide/_HOME.md';
import { guideHome } from '../../data/guide-nav';
import { getGuideHomeUpdated } from '../../lib/guide-home-date.mjs';
import '../../styles/notion.css';

const updated = getGuideHomeUpdated();
const author = typeof frontmatter.author === 'string' ? frontmatter.author.trim() : undefined;
const aiAssistant = typeof frontmatter.aiAssistant === 'string' ? frontmatter.aiAssistant.trim() : undefined;
---

<BaseLayout title={guideHome.title} description={guideHome.description}>
  <script is:inline>
    const guideIllustrationMode = new URLSearchParams(window.location.search).get('illustrations');
    document.documentElement.dataset.guideIllustrations =
      guideIllustrationMode === 'off' || guideIllustrationMode === 'single' ? guideIllustrationMode : 'on';
  </script>
  <div class="wiki-shell guide-doc-shell">
    <div class="container guide-doc-layout">
      <GuideSidebar />

      <div class="guide-paper guide-home-paper notion-page">
        <div class="wiki-main">
          <GuideMobileNav />
          <article aria-labelledby="欢迎来到-cdu-ai">
            <GuideHeading
              title={guideHome.title}
              headingId="欢迎来到-cdu-ai"
              pageHref={guideHome.href}
              author={author}
              aiAssistant={aiAssistant}
              updated={updated}
            />
            <div class="prose wiki-prose notion-prose guide-reading-prose guide-home-prose" data-guide-home-content>
              <GuideHomeContent />
            </div>
          </article>
          <GuidePager />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .guide-home-prose :global(.guide-home-illustration) {
    margin: 1.75rem 0;
  }

  .guide-home-prose :global(.guide-home-illustration img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border: 0;
    border-radius: 8px;
  }

  :global(html[data-guide-illustrations='off']) .guide-home-prose :global(.guide-home-illustration) {
    display: none;
  }

  :global(html[data-guide-illustrations='single']) .guide-home-prose :global(.guide-home-illustration--model) {
    display: none;
  }
</style>
