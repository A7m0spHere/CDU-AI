---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import GuideSidebar from '../../components/GuideSidebar.astro';
import GuideMobileNav from '../../components/GuideMobileNav.astro';
import { guideStages, repository } from '../../data/site';
import { tools } from '../../data/tools';
import '../../styles/notion.css';

export const getStaticPaths = (async () => {
  const modules = await getCollection('guide');
  return modules.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const modules = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
const slug = entry.id.replace(/\.md$/, '');
const index = modules.findIndex((module) => module.id === entry.id);
const previous = index > 0 ? modules[index - 1] : undefined;
const next = index >= 0 && index < modules.length - 1 ? modules[index + 1] : undefined;
const stage = guideStages.find((item) => item.id === entry.data.stage);

const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const editUrl = `${repository.url}/edit/${repository.branch}/src/content/guide/${entry.id}.md`;
const relatedTools = entry.data.tools
  .map((name) => tools.find((tool) => tool.name === name))
  .filter((tool): tool is (typeof tools)[number] => Boolean(tool));
// sources 在 schema 里有默认值；这里再兜底一次，避免旧内容缓存缺字段时详情页渲染崩溃。
const sources = entry.data.sources ?? [];
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="wiki-shell guide-doc-shell">
    <div class="container guide-doc-layout">
      <GuideSidebar currentId={slug} />

      <div class="guide-paper">
        <div class="wiki-main wiki-article notion-page">
        <GuideMobileNav currentId={slug} />

        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/">首页</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <a href="/guide/">学习指南</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <span class="breadcrumb__stage">
            <span>{stage?.label ?? '学习路径'}</span>
            <span class="breadcrumb__sep" aria-hidden="true">/</span>
          </span>
          <span aria-current="page">{entry.data.title}</span>
        </nav>

        <header class="notion-page-head">
          <div class="notion-page-head__title-row">
            <span class="notion-page-head__icon" aria-hidden="true"><Icon name="book-open" size={20} /></span>
            <h1>{entry.data.title}</h1>
          </div>
          <p class="notion-page-head__summary">{entry.data.summary}</p>
        </header>

        <div class="prose wiki-prose notion-prose">
          <Content />
        </div>

        <div class="wiki-takeaway">
          <Icon name="check" size={18} />
          <p><strong>读完这一篇：</strong>{entry.data.outcome}</p>
        </div>

        {relatedTools.length > 0 && (
          <div class="wiki-tool-links">
            <span>这篇用到的工具：</span>
            {relatedTools.map((tool) => (
              <a href={tool.url} target="_blank" rel="noopener noreferrer">
                {tool.name}
                <Icon name="arrow-up-right" size={14} />
              </a>
            ))}
            <a class="text-link" href="/tools/">工具资源</a>
          </div>
        )}

        {sources.length > 0 && (
          <div class="page-sources">
            <p>参考来源</p>
            <ul>
              {sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    {source.title}
                    <Icon name="arrow-up-right" size={13} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="page-meta">
          <span><Icon name="clock" size={14} />最后更新：{entry.data.updated}</span>
          <a href={editUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="pen" size={14} />在 GitHub 编辑本页
            <Icon name="arrow-up-right" size={13} />
          </a>
        </div>

        <nav class="wiki-pager" aria-label="模块翻页">
          {previous ? (
            <a class="wiki-pager__link" href={`/guide/${previous.id.replace(/\.md$/, '')}/`}>
              <span>上一篇</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : (
            <a class="wiki-pager__link" href="/guide/">
              <span>返回</span>
              <strong>学习指南首页</strong>
            </a>
          )}
          {next ? (
            <a class="wiki-pager__link wiki-pager__link--next" href={`/guide/${next.id.replace(/\.md$/, '')}/`}>
              <span>下一篇</span>
              <strong>{next.data.title}</strong>
            </a>
          ) : (
            <a class="wiki-pager__link wiki-pager__link--next" href="/works/">
              <span>继续</span>
              <strong>作品广场</strong>
            </a>
          )}
        </nav>
        </div>

        <aside class="wiki-toc" aria-label="本页内容">
        <p class="wiki-toc__label">本页内容</p>
        {toc.length > 0 && (
          <nav>
            <ol>
              {toc.map((heading) => (
                <li class:list={`wiki-toc__depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>