---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import AsciiAI from '../components/AsciiAI.astro';
import HeroNetwork from '../components/HeroNetwork.astro';
import HomeScenarios from '../components/HomeScenarios.astro';
import HomeExploreMenu from '../components/HomeExploreMenu.astro';
import ExploreDotField from '../components/ExploreDotField.astro';
import { site } from '../data/site';
import '../styles/routes/home.css';
import '../styles/home-v2.css';

---

<BaseLayout>
  <div class="home-v2">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="container home-hero__grid">
        <div class="home-hero__main" data-hero-pixels>
          <canvas class="home-hero__pixels" aria-hidden="true"></canvas>

          <p class="home-hero__kicker" data-enter style="--enter-index: 0">
            <span class="status-dot" aria-hidden="true"></span>
            <span>成都大学 · AI 学习社区</span>
            <span class="home-hero__kicker-sep" aria-hidden="true">/</span>
            <span class="mono">{site.stage}</span>
          </p>

          <h1 id="hero-title" class="home-hero__title" data-enter style="--enter-index: 1">
            <span class="home-hero__wordmark">
              <span class="home-hero__wordmark-cdu">CDU</span>
              <AsciiAI />
              <span class="sr-only"> AI</span>
            </span>
          </h1>

          <p class="home-hero__byline" data-enter style="--enter-index: 2">由成都大学计算机协会制作</p>

          <div class="home-hero__actions btn-row" data-enter style="--enter-index: 3">
            <a class="btn btn--primary" href="/guide/">
              开始学习
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </div>

        <HeroNetwork />
      </div>

      <div class="container home-status">
        <p class="home-status__text">
          <span class="home-status__dot" aria-hidden="true"></span>
          内容重建中：指南、术语与作品正在重新填充；当前可先浏览工具目录，或参与共建。
        </p>
        <a class="home-status__link" href="/about/#contribute">
          了解共建方式
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </section>

    <HomeScenarios />

    <section class="home-explore" aria-labelledby="explore-title" data-reveal>
      <div class="container">
        <div class="home-explore__stage" data-explore-stage>
          <div class="home-explore__layout">
            <div class="home-explore__intro">
              <div class="home-explore__heading">
                <h2 id="explore-title">开始探索AI</h2>
              </div>
              <div class="home-explore__visual">
                <ExploreDotField />
              </div>
            </div>
            <HomeExploreMenu />
          </div>
        </div>
        <div class="home-progress">
          <span class="home-progress__label"><span class="status-dot" aria-hidden="true" /> 正在共建</span>
          <a href="/about/#contribute">一起完善这里 <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/ascii-ai';
  import '../scripts/hero-network';
  import '../scripts/pixel-card';
  import '../scripts/target-reticle';
</script>
