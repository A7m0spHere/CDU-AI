---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/routes/works.css';
import '../../../styles/routes/showcase.css';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import { challengeWorks, safeWorkUrl, starterTemplates, type ChallengeWork } from '../../../data/showcase';
import { challengeConfig } from '../../../data/challenge';

export const getStaticPaths = (() => {
  return challengeWorks
    .filter((work) => work.consent && safeWorkUrl(work.siteUrl))
    .map((work) => ({
      params: { slug: work.slug },
      props: { work },
    }));
}) satisfies GetStaticPaths;

type Props = { work: ChallengeWork };
const { work } = Astro.props;

const siteUrl = safeWorkUrl(work.siteUrl);
if (!siteUrl) throw new Error(`Invalid work site URL: ${work.slug}`);

const template = work.templateSlug
  ? starterTemplates.find((item) => item.slug === work.templateSlug)
  : undefined;
---

<BaseLayout
  title={`${work.title} · 参赛作品`}
  description={`${work.summary} 作者：${work.author}，组别：${work.group}。`}
>
  <PageHero
    eyebrow="参赛作品 · 本次活动"
    title={work.title}
    description={work.summary}
    crumbs={[
      { label: '作品广场', href: '/works/' },
      { label: '参赛作品', href: '/works/#event-works' },
      { label: work.title },
    ]}
    tone="warm"
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href={siteUrl} target="_blank" rel="noopener noreferrer">
        打开作品站点
        <Icon name="external-link" size={16} />
      </a>
      <a class="btn btn--soft" href="/works/#event-works">
        <Icon name="arrow-left" size={15} />
        返回活动广场
      </a>
    </Fragment>

    <Fragment slot="aside">
      <div class="aside-card aside-card--brand">
        <div class="aside-card__head"><Icon name="shield-check" size={17} />展示信息</div>
        <h2>{work.author}</h2>
        <dl class="meta-rows">
          <div><dt>组别</dt><dd>{work.group}</dd></div>
          <div><dt>起点</dt><dd>{template ? template.title : '自由选题'}</dd></div>
          <div><dt>更新</dt><dd>{work.updated}</dd></div>
          <div><dt>展示</dt><dd>经作者授权</dd></div>
        </dl>
      </div>
    </Fragment>
  </PageHero>

  <section class="section section--flush-top">
    <div class="container">
      <div class="work-detail">
        <div class="work-detail__main">
          <div class="work-detail__cover showcase-detail__cover">
            {work.cover ? (
              <img src={work.cover} alt={work.coverAlt ?? work.title} loading="eager" decoding="async" />
            ) : (
              <div class="showcase-detail__placeholder" aria-hidden="true"><Icon name="image" size={32} /></div>
            )}
            <span class="badge badge--sky work-detail__status">参赛作品</span>
          </div>

          <div class="work-facts" aria-label="作品信息">
            <div><span>组别</span><strong>{work.group}</strong></div>
            <div><span>作者 / 队伍</span><strong>{work.author}</strong></div>
            <div><span>起点</span><strong>{template ? template.title : '自由选题'}</strong></div>
            <div><span>更新</span><strong>{work.updated}</strong></div>
          </div>

          {work.members && work.members.length > 0 && (
            <p class="showcase-detail-members">团队成员（昵称）：{work.members.join('、')}</p>
          )}

          {work.sections && work.sections.length > 0 ? (
            <div class="prose work-body">
              {work.sections.map((section) => (
                <section class="showcase-detail-section">
                  <h2>{section.title}</h2>
                  <p>{section.body}</p>
                </section>
              ))}
            </div>
          ) : (
            <div class="notice">
              <Icon name="info" size={17} />
              <p>作者暂未提供更详细的作品说明，可以打开作品站点查看实际效果。</p>
            </div>
          )}

          <div class="showcase-detail-cta card">
            <div>
              <p class="eyebrow">作品站点</p>
              <h2>到作者的 Sites 看实际作品</h2>
              <p>作品由作者维护，本站只展示公开链接与介绍；打开外部站点时请留意其隐私说明。</p>
            </div>
            <a class="btn btn--primary" href={siteUrl} target="_blank" rel="noopener noreferrer">
              打开作品站点
              <Icon name="external-link" size={16} />
            </a>
          </div>

          <div class="notice notice--warm">
            <Icon name="alert-triangle" size={17} />
            <p><strong>展示说明：</strong>本页经作者授权展示，链接由作者维护；如果链接失效或作者希望撤回，请联系组委会。</p>
          </div>

          {template && (
            <div class="showcase-detail-related card">
              <div>
                <p class="eyebrow">作品起点</p>
                <h2>基于「{template.title}」</h2>
                <p>{template.summary}</p>
              </div>
              <a class="btn btn--soft" href={`/works/template/${template.slug}/`}>
                查看模板详情
                <Icon name="arrow-right" size={15} />
              </a>
            </div>
          )}

          <div class="page-meta">
            <span><Icon name="clock" size={14} />最后更新：{work.updated}</span>
            <a href="/events/rules/#rights-and-privacy"><Icon name="shield-check" size={14} />作品权益与展示说明</a>
          </div>

          <nav class="work-detail__nav" aria-label="作品页导航">
            <a class="link-arrow" href="/works/#event-works"><Icon name="arrow-left" size={15} />返回活动广场</a>
            <a class="link-arrow" href="/events/rules/#work-requirements">查看作品要求<Icon name="arrow-right" size={15} /></a>
          </nav>
        </div>

        <aside class="work-detail__aside">
          <div class="aside-card">
            <div class="aside-card__head"><Icon name="info" size={16} />作品档案</div>
            <dl class="meta-rows">
              <div><dt>活动</dt><dd>{challengeConfig.shortTitle}</dd></div>
              <div><dt>组别</dt><dd>{work.group}</dd></div>
              <div><dt>作者 / 队伍</dt><dd>{work.author}</dd></div>
              <div><dt>起点</dt><dd>{template ? template.title : '自由选题'}</dd></div>
            </dl>
          </div>

          <div class="aside-card">
            <div class="aside-card__head"><Icon name="spark" size={16} />标签</div>
            <ul class="tag-list">{work.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
          </div>

          {template && (
            <div class="aside-card">
              <div class="aside-card__head"><Icon name="layers" size={16} />基于模板</div>
              <a class="text-link" href={`/works/template/${template.slug}/`}>{template.title} →</a>
            </div>
          )}

          <div class="aside-card aside-card--brand">
            <div class="aside-card__head"><Icon name="shield-check" size={16} />展示与授权</div>
            <p>本页只展示作者提供的公开信息；作品内容由作者维护。希望撤回展示时，请联系组委会。</p>
            <a class="text-link" href="/events/rules/#rights-and-privacy">查看作品权益说明 →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
