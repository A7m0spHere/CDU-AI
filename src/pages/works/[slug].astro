---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import WorkArt from '../../components/WorkArt.astro';
import { tools } from '../../data/tools';
import { repository } from '../../data/site';

export const getStaticPaths = (async () => {
  const works = await getCollection('works');
  return works.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, summary, category, format, tools: toolNames, tags, prompt, effort, level, status } = entry.data;
const { Content } = await render(entry);
const relatedTools = toolNames
  .map((name) => tools.find((tool) => tool.name === name))
  .filter((tool): tool is (typeof tools)[number] => Boolean(tool));
const isExample = status === 'example';
const updated = entry.data.updated;
const editUrl = `${repository.url}/edit/${repository.branch}/src/content/works/${entry.id}.md`;
---

<BaseLayout title={title} description={summary}>
  <PageHero
    eyebrow={`作品广场 · ${category}`}
    title={title}
    description={summary}
    crumbs={[
      { label: '作品广场', href: '/works/' },
      { label: title },
    ]}
    tone="warm"
  >
    <Fragment slot="actions">
      <a class="btn btn--soft btn--sm" href="/works/">
        <Icon name="arrow-left" size={15} />
        返回作品广场
      </a>
      <span class="badge badge--example">{isExample ? '策划示例 · 非真实投稿' : '社区作品'}</span>
    </Fragment>
  </PageHero>

  <section class="section section--flush-top">
    <div class="container">
      <div class="work-detail">
        <div class="work-detail__main">
          <div class="work-detail__cover">
            <WorkArt category={category} />
            <span class="badge badge--example work-detail__status">
              {isExample ? '策划示例 · 概念视觉' : '社区作品'}
            </span>
          </div>

          <div class="work-facts" aria-label="作品信息">
            <div><span>形式</span><strong>{format}</strong></div>
            <div><span>投入</span><strong>{effort}</strong></div>
            <div><span>难度</span><strong>{level}</strong></div>
            <div><span>类别</span><strong>{category}</strong></div>
          </div>

          <div class="prompt-card card">
            <div class="prompt-card__head">
              <div>
                <p class="eyebrow eyebrow--plain">STARTING PROMPT</p>
                <h2>一个起点提示词</h2>
              </div>
              <button
                class="copy-button"
                type="button"
                data-copy-target="#work-prompt"
                aria-label="复制起点提示词"
              >
                <Icon name="copy" size={15} />
                <span data-copy-label>复制</span>
              </button>
            </div>
            <pre id="work-prompt"><code>{prompt}</code></pre>
            <p class="prompt-card__note">
              提示词只是起点。实际做的时候要根据输出继续补充约束、换例子、缩小范围；不要直接把第一轮结果当成品。
            </p>
          </div>

          <div class="prose work-body">
            <Content />
          </div>

          <div class="notice notice--warm">
            <Icon name="alert-triangle" size={17} />
            <p>
              <strong>边界说明：</strong>
              {isExample
                ? '这是一条策划示例，用于展示作品可以如何被组织，不代表已经有人完成了它，也不代表这个方案已经在真实场景验证过。'
                : '页面内容由作者提供并经维护者审核，具体事实与授权信息以作者声明为准。'}
            </p>
          </div>

          {updated && (
            <div class="page-meta">
              <span><Icon name="clock" size={14} />最后更新：{updated}</span>
              <a href={editUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="pen" size={14} />在 GitHub 编辑本页
                <Icon name="arrow-up-right" size={13} />
              </a>
            </div>
          )}

          <nav class="work-detail__nav" aria-label="作品页导航">
            <a class="link-arrow" href="/works/"><Icon name="arrow-left" size={15} />回到作品广场</a>
            <a class="link-arrow" href="/guide/">继续读学习指南<Icon name="arrow-right" size={15} /></a>
          </nav>
        </div>

        <aside class="work-detail__aside">
          <div class="aside-card">
            <div class="aside-card__head"><Icon name="info" size={16} />作品档案</div>
            <dl class="meta-rows">
              <div><dt>类别</dt><dd>{category}</dd></div>
              <div><dt>形式</dt><dd>{format}</dd></div>
              <div><dt>投入</dt><dd>{effort}</dd></div>
              <div><dt>难度</dt><dd>{level}</dd></div>
            </dl>
          </div>

          <div class="aside-card">
            <div class="aside-card__head"><Icon name="wrench" size={16} />用到的工具</div>
            {relatedTools.length > 0 ? (
              <ul class="tool-link-list">
                {relatedTools.map((tool) => (
                  <li>
                    <a href={tool.url} target="_blank" rel="noopener noreferrer">
                      {tool.name}
                      <Icon name="arrow-up-right" size={14} />
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <ul class="tag-list">{toolNames.map((name) => <li class="tag">{name}</li>)}</ul>
            )}
            <a class="text-link" href="/tools/">按场景浏览工具 →</a>
          </div>

          <div class="aside-card">
            <div class="aside-card__head"><Icon name="spark" size={16} />标签</div>
            <ul class="tag-list">{tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
          </div>

          <div class="aside-card aside-card--brand">
            <div class="aside-card__head"><Icon name="shield-check" size={16} />M1 投稿说明</div>
            <p>
              真实作品投稿会要求作者署名、原创与授权说明，并经过人工审核。现在没有开放表单，也不会收集你的内容。
            </p>
            <a class="text-link" href="/about/#standards">查看内容规范 →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>