---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import WorkCard from '../../components/WorkCard.astro';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const categories = ['校园生活', '学习效率', '创意表达', '跨专业实验'].filter((category) =>
  works.some((work) => work.data.category === category),
);
---

<BaseLayout
  title="作品广场"
  description="4 个策划示例，展示问题、做法与提示词。不是真实学生投稿。"
>
  <PageHero
    eyebrow="作品广场 · 策划示例"
    title="作品广场"
    description="4 个策划示例，展示问题、做法与提示词。不是真实学生投稿。"
    crumbs={[{ label: '作品广场' }]}
    tone="warm"
  >
    <Fragment slot="aside">
      <div class="aside-card aside-card--brand">
        <div class="aside-card__head"><Icon name="info" size={17} />为什么现在只有示例？</div>
        <h2>M0 只展示示例。</h2>
        <p>所有条目均标注「策划示例」，没有成品链接，也不冒用同学姓名。真实投稿与署名规则将在 M1 设计。</p>
        <a class="text-link" href="/about/#standards">内容规范 →</a>
      </div>
    </Fragment>
  </PageHero>

  <section class="section section--flush-top">
    <div class="container">
      <div class="notice notice--warm">
        <Icon name="alert-triangle" size={17} />
        <p><strong>先说明：</strong>本页条目均为策划示例，不是真实学生作品，也没有成品链接。</p>
      </div>

      <h2 class="sr-only">策划示例列表</h2>
      <div class="directory directory--works" data-filter-root>
        <div class="filter-row works-toolbar">
          <div class="filter-chips" role="group" aria-label="按作品类别筛选">
            <button class="filter-chip" type="button" data-filter-value="all" aria-pressed="true">全部</button>
            {categories.map((category) => (
              <button class="filter-chip" type="button" data-filter-value={category} aria-pressed="false">{category}</button>
            ))}
          </div>
          <div class="results-bar">
            <p aria-live="polite">显示 <strong data-filter-count>{works.length}</strong> 个示例</p>
            <button class="clear-filters" type="button" data-clear-filters hidden>清除筛选</button>
          </div>
        </div>

        <div class="works-grid">
          {works.map((work) => (
            <div
              class="work-cell"
              data-filter-card
              data-category={work.data.category}
              data-search={`${work.data.title} ${work.data.summary} ${work.data.format} ${work.data.tags.join(' ')}`.toLowerCase()}
            >
              <WorkCard work={work} />
            </div>
          ))}
        </div>

        <div class="empty-state" data-empty-state hidden>
          <Icon name="search" size={28} />
          <h2>这个分类还没有示例</h2>
          <p>试试其他类别，或点击「清除筛选」查看全部策划示例。</p>
        </div>
      </div>

      <div class="works-footer">
        <div>
          <p class="eyebrow">投稿通道</p>
          <h2>M1 开放真实投稿</h2>
          <p>规则、授权与审核流程明确前，不收集作品或个人信息。</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/about/#contribute">了解共建方式<Icon name="arrow-right" size={16} /></a>
          <a class="btn btn--soft" href="/guide/">先读学习指南</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initFilter } from '../../scripts/filter';
  initFilter();
</script>