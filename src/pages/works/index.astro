---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/routes/works.css';
import '../../styles/routes/showcase.css';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import WorkCard from '../../components/WorkCard.astro';
import ShowcaseCard from '../../components/ShowcaseCard.astro';
import EmptyContent from '../../components/EmptyContent.astro';
import { repository } from '../../data/site';
import { challengeConfig } from '../../data/challenge';
import { starterTemplates, challengeWorks, safeWorkUrl, allTemplatesDownloadPath } from '../../data/showcase';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const isEmpty = works.length === 0;
const categories = ['校园生活', '学习效率', '创意表达', '跨专业实验'].filter((category) =>
  works.some((work) => work.data.category === category),
);
const contributeLinks = [
  { label: '参与共建', href: '/about/#contribute' },
  { label: '投稿真实经验', href: `${repository.url}/issues/new?template=experience-submission.yml`, external: true },
];

const publishedWorks = challengeWorks.filter((work) => work.consent && safeWorkUrl(work.siteUrl));
const templateNames = new Map(starterTemplates.map((template) => [template.slug, template.title]));
---

<BaseLayout
  title="作品广场"
  description="AI 创作挑战赛活动广场：本次活动模板可在线体验；参赛作品以作者自己的 Sites 链接展示。"
>
  <div class="works-header">
  <PageHeader
    index="04"
    eyebrow="作品广场 · 活动广场"
    title="作品广场"
    lede="本次 AI 创作挑战赛的模板与参赛作品集中在这里；模板可直接在线体验，参赛作品以作者自己的 Sites 链接展示。"
    meta={[
      { label: '本次活动模板', tone: 'brand' },
      { label: '参赛作品 · 外部链接' },
      { label: '策划示例 · M0', tone: 'warn' },
    ]}
    crumbs={[{ label: '作品广场' }]}
  >
    <Fragment slot="aside">
      <div class="aside-card aside-card--brand">
        <div class="aside-card__head"><Icon name="calendar" size={17} />本次活动</div>
        <h2>第八届 AI 创作挑战赛</h2>
        <dl class="meta-rows">
          <div><dt>赛期</dt><dd>{challengeConfig.dates.overall}</dd></div>
          <div><dt>模板</dt><dd>{starterTemplates.length} 个 · 站内体验</dd></div>
          <div><dt>作品</dt><dd>{publishedWorks.length} 件 · 外部链接</dd></div>
        </dl>
        <a class="text-link" href="/events/">查看活动与报名 →</a>
      </div>
    </Fragment>
  </PageHeader>
  </div>

  <section class="section section--flush-top">
    <div class="container">
      <div class="notice notice--warm">
        <Icon name="info" size={17} />
        <p>
          <strong>本次活动模板：</strong>以下模板由组委会为{challengeConfig.shortTitle}制作，仅供本届参赛者学习与改造；在线版不收集数据，作品提交与评审以活动页规则为准。
        </p>
      </div>

      <div class="showcase-group" id="event-templates">
        <div class="section-head">
          <div class="section-head__copy">
            <p class="eyebrow">本次活动模板</p>
            <h2>AI 创作挑战赛 · 新手模板</h2>
            <p class="section-head__desc">{starterTemplates.length} 个单文件网页，可直接在线体验；先跑通，再做至少一项功能或交互改动。</p>
          </div>
          <span class="pill">仅限本次活动</span>
        </div>

        <div class="showcase-grid">
          {starterTemplates.map((template) => (
            <ShowcaseCard
              title={template.title}
              summary={template.summary}
              cover={template.cover}
              coverAlt={template.coverAlt}
              badge="本次活动模板"
              badgeTone="brand"
              meta={[template.format, `上手 ${template.onboarding}`, `改造 ${template.ceiling}`]}
              tags={template.tags}
              href={`/works/template/${template.slug}/`}
              ctaLabel="查看模板详情"
            />
          ))}
        </div>
        <p class="showcase-note">
          进入模板详情可以看功能清单、下载模板包或在线体验；标签里的「上手」是从打开到能玩的时间，「改造」是继续深改的空间。模板包内含说明、启动提示词、AI 使用记录和过程记录模板。
          <a href={allTemplatesDownloadPath} download>下载全部模板包（zip）</a>
        </p>
      </div>

      <div class="showcase-group" id="event-works">
        <div class="section-head">
          <div class="section-head__copy">
            <p class="eyebrow">参赛作品</p>
            <h2>本次活动的参赛作品</h2>
            <p class="section-head__desc">作品提交截止后，经作者授权，按组别展示作品介绍与封面；进入详情页再打开作者的作品站点。本站不复制、不托管作品内容。</p>
          </div>
          <span class="pill">{publishedWorks.length > 0 ? `${publishedWorks.length} 件作品` : '提交后开放'}</span>
        </div>

        {publishedWorks.length === 0 ? (
          <EmptyContent
            icon="sprout"
            status="作品提交后开放"
            title="首批参赛作品还在路上"
            description="12 月 4 日 18:00 作品提交截止。经审核与作者授权后，这里会展示作品链接、介绍和封面；本站不复制、不托管作品内容。"
            links={[
              { label: '查看作品提交要求', href: '/events/#submit' },
              { label: '展示与授权说明', href: '/events/rules/#rights-and-privacy' },
            ]}
          />
        ) : (
          <div class="showcase-grid">
            {publishedWorks.map((work) => (
              <ShowcaseCard
                title={work.title}
                summary={work.summary}
                cover={work.cover}
                coverAlt={work.coverAlt}
                badge={work.group}
                badgeTone="sky"
                meta={[
                  work.group,
                  `作者：${work.author}`,
                  ...(work.templateSlug && templateNames.has(work.templateSlug)
                    ? [`基于「${templateNames.get(work.templateSlug)}」`]
                    : []),
                ]}
                tags={work.tags}
                href={`/works/project/${work.slug}/`}
                ctaLabel="查看作品详情"
              />
            ))}
          </div>
        )}

        <p class="showcase-note">作品链接由作者维护。如果链接失效，或你希望撤回展示，请联系组委会。</p>
      </div>

      <div class="showcase-group" id="examples">
        <div class="section-head">
          <div class="section-head__copy">
            <p class="eyebrow">站内策划示例</p>
            <h2>策划示例 · M0</h2>
            <p class="section-head__desc">
              站点自身的作品示例，不是本次活动的参赛作品，也不是真实学生投稿。{!isEmpty && `共 ${works.length} 个策划示例。`}
            </p>
          </div>
        </div>

        {isEmpty ? (
          <EmptyContent
            icon="spark"
            title="作品示例正在准备中"
            description="这里将展示明确标注为「策划示例」的作品，不是真实学生投稿，也不是本次活动的参赛作品。第一批示例正在整理中，欢迎分享你的真实经验。"
            links={contributeLinks}
          />
        ) : (
          <>
            <div class="notice notice--warm">
              <Icon name="alert-triangle" size={17} />
              <p><strong>先说明：</strong>本区条目均为策划示例，不是真实学生作品，也不是本次活动的参赛作品。</p>
            </div>

            <h2 class="sr-only">策划示例列表</h2>
            <div class="directory directory--works" data-filter-root>
              <div class="filter-row works-toolbar">
                <div class="filter-chips" role="group" aria-label="按作品类别筛选">
                  <button class="filter-chip" type="button" data-filter-value="all" aria-pressed="true">全部</button>
                  {categories.map((category) => (
                    <button class="filter-chip" type="button" data-filter-value={category} aria-pressed="false">{category}</button>
                  ))}
                </div>
                <div class="results-bar">
                  <p aria-live="polite">显示 <strong data-filter-count>{works.length}</strong> 个示例</p>
                  <button class="clear-filters" type="button" data-clear-filters hidden>清除筛选</button>
                </div>
              </div>

              <div class="works-grid">
                {works.map((work) => (
                  <div
                    class="work-cell"
                    data-filter-card
                    data-category={work.data.category}
                    data-search={`${work.data.title} ${work.data.summary} ${work.data.format} ${work.data.tags.join(' ')}`.toLowerCase()}
                  >
                    <WorkCard work={work} />
                  </div>
                ))}
              </div>

              <div class="empty-state" data-empty-state hidden>
                <Icon name="search" size={28} />
                <h2>这个分类还没有示例</h2>
                <p>试试其他类别，或点击「清除筛选」查看全部策划示例。</p>
              </div>
            </div>
          </>
        )}
      </div>

      <div class="showcase-footer">
        <div>
          <p class="eyebrow">提交与展示</p>
          <h2>做完作品，把链接和介绍交上来</h2>
          <p>本次活动的作品提交截止 12 月 4 日 18:00；经审核和作者授权后，才会出现在作品广场。</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/events/#submit">查看作品提交要求<Icon name="arrow-right" size={16} /></a>
          <a class="btn btn--soft" href="/events/rules/#rights-and-privacy">展示与授权说明</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initFilter } from '../../scripts/filter';
  initFilter();
</script>
