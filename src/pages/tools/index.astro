---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools, toolCategories, toolCapabilities, agentSpotlightIds } from '../../data/tools';
import type { Tool } from '../../data/types';

const counts = new Map(toolCategories.map((category) => [category.id, tools.filter((tool) => tool.category === category.id || (tool.alsoIn ?? []).includes(category.id)).length]));
const capCounts = new Map(toolCapabilities.map((cap) => [cap.id, tools.filter((tool) => tool.capabilities.includes(cap.id)).length]));
const hasTools = tools.length > 0;
const suggestionUrl = 'https://github.com/A7m0spHere/CDU-AI/issues/new?template=tool-suggestion.yml';
const categoryName = (id: string) => toolCategories.find((category) => category.id === id)?.name ?? '工具';

// Agent 与 Harness 的默认展示：主流产品与少量常用社区条目直接显示，
// 其余社区 / 小众 Agent 收进折叠区。搜索或筛选生效时折叠区自动展开（见 scripts/filter.ts），
// 结果数量与搜索索引始终按完整目录计算，避免折叠后漏掉收录。
const spotlightAgentIds = new Set(agentSpotlightIds);
const isAgentTool = (tool: Tool) => tool.category === 'agent';
const isCollapsedAgent = (tool: Tool) =>
  isAgentTool(tool) && tool.tier !== '主流产品' && !spotlightAgentIds.has(tool.id);
const collapsedAgentTools = tools.filter(isCollapsedAgent);
const visibleTools = tools.filter((tool) => !isCollapsedAgent(tool));
const collapseAfterId = [...visibleTools].reverse().find(isAgentTool)?.id;
const showCollapsedAgents = collapsedAgentTools.length > 0 && Boolean(collapseAfterId);
---

<BaseLayout
  title="AI 工具资源"
  description={
    hasTools
      ? `按使用场景整理的 AI 工具索引，共 ${tools.length} 个工具、${toolCategories.length} 个分类。标注类型、门槛、费用与限制。`
      : '工具目录由维护者按需补充：标注使用场景、上手门槛、费用模式与限制，收录不等于推荐。'
  }
>
  <PageHeader
    index="03"
    eyebrow="工具资源"
    title="AI 工具资源"
    lede="按使用场景分类，写清技术类型、上手门槛、费用与限制。收录不等于推荐，也不按热度排名。"
    meta={
      hasTools
        ? [
            { label: tools.length + ' 个工具', tone: 'brand' },
            { label: toolCategories.length + ' 个场景' },
            { label: '收录 ≠ 推荐' },
          ]
        : [{ label: '待补充', tone: 'brand' }, { label: '收录 ≠ 推荐' }]
    }
    crumbs={[{ label: '工具资源' }]}
  >
    <Fragment slot="aside">
      <div class="aside-card">
        <div class="aside-card__head"><Icon name="layers" size={17} />当前收录</div>
        <dl class="aside-stat-row">
          <div><dt>工具</dt><dd>{String(tools.length).padStart(2, '0')}</dd></div>
          <div><dt>场景分类</dt><dd>{String(toolCategories.length).padStart(2, '0')}</dd></div>
        </dl>
        <p>{hasTools ? '持续补充中，收录不等于推荐。' : '由维护者按需补充，收录不等于推荐。'}</p>
        <a class="aside-card__link" href={suggestionUrl} target="_blank" rel="noopener noreferrer">
          建议收录工具
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </Fragment>
  </PageHeader>

  <section class="section section--flush-top">
    <div class="container">
      <div class="notice notice--warm" data-reveal>
        <Icon name="info" size={17} />
        <p><strong>收录不等于推荐，也不是广告。</strong>工具能力、价格和可用地区会变化，请以官网为准。不要输入个人敏感信息；生成内容发布前先确认版权与授权。</p>
      </div>

      <h2 class="sr-only">工具目录</h2>
      {hasTools && (
      <div class="catalog-layout" data-filter-root data-reveal>
        <aside class="catalog-sidebar" aria-label="工具筛选">
          <label class="sr-only" for="tool-search">搜索工具名、别名、场景或技术类型</label>
          <div class="search-field">
            <Icon name="search" size={18} />
            <input
              id="tool-search"
              type="search"
              placeholder="搜索工具、别名或技术类型…"
              autocomplete="off"
              data-filter-search
            />
          </div>

          <nav class="catalog-nav" aria-label="按场景筛选">
            <div class="catalog-nav__head">
              <span>使用场景</span>
              <span class="filter-count">{tools.length} 个条目</span>
            </div>
            <div class="filter-chips filter-chips--vertical" role="group" aria-label="按场景筛选">
              <button class="filter-chip" type="button" data-filter-value="all" aria-pressed="true">
                全部工具
                <span class="filter-chip__count">{tools.length}</span>
              </button>
              {toolCategories.map((category) => (
                <button
                  class="filter-chip"
                  type="button"
                  data-filter-value={category.id}
                  aria-pressed="false"
                  title={category.techHint}
                >
                  {category.name}
                  <span class="filter-chip__count">{counts.get(category.id) ?? 0}</span>
                </button>
              ))}
            </div>
          </nav>

          <div class="catalog-nav">
            <div class="catalog-nav__head">
              <span>能力筛选</span>
              <span class="filter-count">可多选</span>
            </div>
            <div class="filter-chips filter-chips--vertical" role="group" aria-label="按能力筛选">
              {toolCapabilities.map((cap) => (
                <button
                  class="filter-chip filter-chip--cap"
                  type="button"
                  data-filter-cap={cap.id}
                  aria-pressed="false"
                  title={cap.hint}
                >
                  {cap.label}
                  <span class="filter-chip__count">{capCounts.get(cap.id) ?? 0}</span>
                </button>
              ))}
            </div>
          </div>

          <p class="catalog-sidebar__note">
            <Icon name="info" size={14} />
            场景是单选，能力可多选并取交集；搜索会忽略场景筛选，但保留能力筛选。Agent 与 Harness 的社区条目默认收起，搜索或筛选时会自动展开。
          </p>
        </aside>

        <div class="catalog-main">
          <div class="results-bar">
            <p aria-live="polite">显示 <strong data-filter-count>{tools.length}</strong> 个工具</p>
            <button class="clear-filters" type="button" data-clear-filters hidden>清除筛选</button>
          </div>

          <div class="tool-grid">
            {visibleTools.map((tool) => (
              <>
                <ToolCard
                  tool={tool}
                  categoryLabel={categoryName(tool.category)}
                />
                {showCollapsedAgents && tool.id === collapseAfterId && (
                  <details class="tool-more" data-filter-group data-collapse>
                    <summary class="tool-more__summary">
                      <span class="tool-more__heading">
                        <span class="tool-more__title">更多社区 Agent 与 Harness</span>
                        <span class="tool-more__meta">
                          {collapsedAgentTools.length} 个条目 · 默认收起，搜索或筛选时自动展开
                        </span>
                      </span>
                      <Icon name="chevron-down" size={18} class="tool-more__icon" />
                    </summary>
                    <div class="tool-grid tool-more__grid">
                      {collapsedAgentTools.map((collapsedTool) => (
                        <ToolCard
                          tool={collapsedTool}
                          categoryLabel={categoryName(collapsedTool.category)}
                          collapsed
                        />
                      ))}
                    </div>
                  </details>
                )}
              </>
            ))}
          </div>

          <div class="empty-state" data-empty-state hidden>
            <Icon name="search" size={28} />
            <h2>没有找到匹配的工具</h2>
            <p>试试更短的关键词、换一个场景，或者点击「清除筛选」看看全部条目。</p>
          </div>

          <div class="catalog-cta">
            <div>
              <h2>发现好用的工具？</h2>
              <p>工具目录由维护者审核后入库，不收自动提交。请用仓库的「工具建议」Issue 模板说明用途、官网与限制。</p>
            </div>
            <a class="btn btn--soft btn--sm" href={suggestionUrl} target="_blank" rel="noopener noreferrer">
              建议收录工具
              <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
        </div>
      </div>
      )}

      {!hasTools && (
        <div class="empty-state">
          <Icon name="layers" size={28} />
          <h2>工具目录暂时为空</h2>
          <p>工具由维护者按需补充：会写清使用场景、上手门槛、费用与限制，并标注「收录不等于推荐」。</p>
        </div>
      )}

    </div>
  </section>
</BaseLayout>

<script>
  import { initFilter } from '../../scripts/filter';
  initFilter();
</script>
