---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools, toolCategories } from '../../data/tools';

const counts = new Map(toolCategories.map((category) => [category.id, tools.filter((tool) => tool.category === category.id).length]));
---

<BaseLayout
  title="AI 工具资源"
  description={`按使用场景整理的 AI 工具索引，共 ${tools.length} 个工具、${toolCategories.length} 个分类。标注门槛、费用与限制。`}
>
  <PageHeader
    index="03"
    eyebrow="工具资源"
    title="AI 工具资源"
    lede="按使用场景分类。标注上手门槛、费用模式与限制；收录不等于推荐。"
    meta={[
      { label: tools.length + ' 个工具', tone: 'brand' },
      { label: toolCategories.length + ' 个场景' },
      { label: '收录 ≠ 推荐' },
    ]}
    crumbs={[{ label: '工具资源' }]}
  >
    <Fragment slot="aside">
      <div class="aside-card">
        <div class="aside-card__head"><Icon name="layers" size={17} />当前收录</div>
        <dl class="aside-stat-row">
          <div><dt>工具</dt><dd>{String(tools.length).padStart(2, '0')}</dd></div>
          <div><dt>场景分类</dt><dd>{String(toolCategories.length).padStart(2, '0')}</dd></div>
        </dl>
        <p>持续补充中，收录不等于推荐。</p>
      </div>
    </Fragment>
  </PageHeader>

  <section class="section section--flush-top">
    <div class="container">
      <div class="notice notice--warm" data-reveal>
        <Icon name="info" size={17} />
        <p><strong>收录不等于推荐，也不是广告。</strong>工具能力、价格和可用地区会变化，请以官网为准。不要输入个人敏感信息。</p>
      </div>

      <h2 class="sr-only">工具目录</h2>
      <div class="catalog-layout" data-filter-root data-reveal>
        <aside class="catalog-sidebar" aria-label="工具筛选">
          <label class="sr-only" for="tool-search">搜索工具名、使用场景或标签</label>
          <div class="search-field">
            <Icon name="search" size={18} />
            <input
              id="tool-search"
              type="search"
              placeholder="搜索工具或场景…"
              autocomplete="off"
              data-filter-search
            />
          </div>

          <nav class="catalog-nav" aria-label="按场景筛选">
            <div class="catalog-nav__head">
              <span>使用场景</span>
              <span class="filter-count">{tools.length} 个条目</span>
            </div>
            <div class="filter-chips filter-chips--vertical" role="group" aria-label="按场景筛选">
              <button class="filter-chip" type="button" data-filter-value="all" aria-pressed="true">
                全部工具
                <span class="filter-chip__count">{tools.length}</span>
              </button>
              {toolCategories.map((category) => (
                <button class="filter-chip" type="button" data-filter-value={category.id} aria-pressed="false">
                  {category.name}
                  <span class="filter-chip__count">{counts.get(category.id) ?? 0}</span>
                </button>
              ))}
            </div>
          </nav>

          <p class="catalog-sidebar__note">
            <Icon name="info" size={14} />
            按真实使用场景整理，不按热度排名。收录不等于推荐。
          </p>
        </aside>

        <div class="catalog-main">
          <div class="results-bar">
            <p aria-live="polite">显示 <strong data-filter-count>{tools.length}</strong> 个工具</p>
            <button class="clear-filters" type="button" data-clear-filters hidden>清除筛选</button>
          </div>

          <div class="tool-grid">
            {tools.map((tool) => (
              <ToolCard
                tool={tool}
                categoryLabel={toolCategories.find((category) => category.id === tool.category)?.name ?? '工具'}
              />
            ))}
          </div>

          <div class="empty-state" data-empty-state hidden>
            <Icon name="search" size={28} />
            <h2>没有找到匹配的工具</h2>
            <p>试试更短的关键词、换一个分类，或者点击「清除筛选」看看全部条目。</p>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  import { initFilter } from '../../scripts/filter';
  initFilter();
</script>