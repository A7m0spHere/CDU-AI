---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Icon from '../../components/Icon.astro';
import { repository } from '../../data/site';

const issueUrl = repository.url + '/issues/new';

const columns = [
  {
    label: '已完成',
    hint: '已经有可查看的结果',
    tasks: [
      { title: '静态站点与内容骨架', note: '首页、指南、工具、作品、社区、活动与关于页可构建。', tags: ['M0', '站点'] },
      { title: '章节级全文搜索', note: '页面、指南/作品章节和术语都能搜到，结果可跳锚点。', tags: ['M0', '搜索'] },
      { title: 'AI 术语表', note: '24 条术语，含释义、校园场景示例和来源链接。', tags: ['M0', '内容'] },
      { title: '内容元信息', note: '指南与作品显示更新时间、参考来源和 GitHub 编辑入口。', tags: ['M0', '内容'] },
      { title: 'GitHub 仓库与 CI', note: 'MIT 协议、公开仓库，推送后自动执行验证。', tags: ['M0', '工程'] },
      { title: '团队文档区', note: '阅读计划、任务看板、内容流程和技术资料入口。', tags: ['M0', '文档'] },
    ],
  },
  {
    label: '下一步',
    hint: '条件明确后再开始',
    tasks: [
      { title: 'GitHub Pages 部署', note: '确定正式域名后补 sitemap、canonical 与部署 workflow。', tags: ['M1', '部署'] },
      { title: '投稿与入库流程', note: '先做 GitHub PR 流程；有真实作品后再评估表单和审核。', tags: ['M1', '内容'] },
      { title: '社区与活动开放', note: '需要明确负责人、审核与安全边界，不提前开放空版块。', tags: ['M1', '运营'] },
      { title: '技术文档持续维护', note: '内容模型、搜索和设计系统变更后同步更新。', tags: ['持续', '工程'] },
    ],
  },
  {
    label: '待定',
    hint: '依赖真实需求或外部条件',
    tasks: [
      { title: '登录与成员账号', note: '涉及后端、隐私和数据管理，暂不进入静态站。', tags: ['M2', '后端'] },
      { title: '评论 / 点赞', note: '需要审核与反滥用机制，先保留讨论入口。', tags: ['M2', '社区'] },
      { title: '真实活动排期', note: '只在负责人确认日期、场地后发布，不写占位时间。', tags: ['待确认', '活动'] },
      { title: '后台编辑器', note: '当前用 GitHub 文件编辑已够用；先验证内容量再做。', tags: ['待评估', '工具'] },
    ],
  },
];
---

<DocsLayout current="tasks">
  <div class="doc-callout">
    <Icon name="info" size={16} />
    <p>
      本页是<strong>公开任务快照</strong>，不是实时看板，也不代表有人已经被分配了工作。状态以仓库提交和讨论为准；要认领或调整任务，请先到 GitHub issue 说明。
    </p>
  </div>

  <h2>当前看板</h2>
  <div class="doc-kanban">
    {columns.map((column) => (
      <section class="doc-kanban__column" aria-labelledby={`task-column-${column.label}`}>
        <div class="doc-kanban__head">
          <h3 id={`task-column-${column.label}`}>{column.label}</h3>
          <span class="doc-kanban__count">{column.tasks.length}</span>
        </div>
        <p class="doc-section-label">{column.hint}</p>
        {column.tasks.map((task) => (
          <article class="doc-task">
            <h3>{task.title}</h3>
            <p>{task.note}</p>
            <div class="doc-task__footer">
              {task.tags.map((tag) => <span class="doc-task__tag">{tag}</span>)}
            </div>
          </article>
        ))}
      </section>
    ))}
  </div>

  <h2>怎么新增或认领任务</h2>
  <ol class="doc-steps">
    <li>
      <strong>先开 issue，不直接写代码</strong>
      <p>说明想做什么、为什么现在做、验收标准是什么。还没有把握时，用 issue 讨论范围即可。</p>
    </li>
    <li>
      <strong>等一个明确的范围</strong>
      <p>把任务缩到一个 PR 能完成的大小；涉及内容事实、隐私或活动的任务，先确认依据和负责人。</p>
    </li>
    <li>
      <strong>完成后同步文档</strong>
      <p>任务状态、内容规范或技术决策发生变化时，在同一个 PR 或 issue 中更新对应文档，避免看板和现实脱节。</p>
    </li>
  </ol>

  <a class="doc-link-card" href={issueUrl} target="_blank" rel="noopener noreferrer">
    <strong>＋ 新建任务 issue</strong>
    <span>在 GitHub 打开新 issue，写清背景、范围和验收标准。</span>
    <em>github.com/A7m0spHere/CDU-AI/issues</em>
  </a>

  <div class="doc-callout doc-callout--warm">
    <Icon name="alert-triangle" size={16} />
    <p>
      不要把「讨论过」写成「已经完成」，也不要把待定事项包装成正在推进。任务看板宁可少一条，也不要虚构一条。
    </p>
  </div>
</DocsLayout>
