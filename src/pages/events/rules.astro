---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/routes/events.css';
import PageHero from '../../components/PageHero.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import Icon from '../../components/Icon.astro';
import {
  challengeConfig,
  ruleSections,
  scoringGroups,
  awardRows,
  awardNotes,
} from '../../data/challenge';

const tocHeadings = ruleSections.flatMap((section) => [
  { depth: 2, slug: section.id, text: section.title },
  ...(section.id === 'judging-and-awards'
    ? scoringGroups.map((group) => ({ depth: 3, slug: `scoring-${group.id}`, text: group.label }))
    : []),
]);
---

<BaseLayout
  title={`完整赛事细则 · ${challengeConfig.title}`}
  description={`${challengeConfig.title}完整赛事细则，含组队、作品提交、赛程、评分表与奖项。`}
>
  <PageHero
    eyebrow="活动 · 正式细则"
    title="完整赛事细则"
    description={`${challengeConfig.title}的组队、作品提交、评审和奖项规则。`}
    crumbs={[
      { label: '活动', href: '/events/' },
      { label: '完整赛事细则' },
    ]}
    tone="warm"
  >
    <Fragment slot="actions">
      <a class="btn btn--soft btn--sm" href="/events/">
        <Icon name="arrow-left" size={15} />
        返回活动主页
      </a>
      <a class="btn btn--primary btn--sm" href="/events/#register">
        前往报名入口
        <Icon name="arrow-right" size={15} />
      </a>
    </Fragment>

    <Fragment slot="aside">
      <div class="aside-card">
        <div class="aside-card__head">
          <Icon name="shield-check" size={16} />
          文档说明
        </div>
        <dl class="meta-rows">
          <div><dt>适用赛事</dt><dd>{challengeConfig.shortTitle}</dd></div>
          <div><dt>承办</dt><dd>成都大学计算机协会</dd></div>
          <div><dt>活动周期</dt><dd>{challengeConfig.dates.overall}</dd></div>
          <div><dt>最近更新</dt><dd>{challengeConfig.updatedOn}</dd></div>
        </dl>
      </div>
    </Fragment>
  </PageHero>

  <section class="section section--flush-top">
    <div class="container">
      <div class="challenge-doc-layout">
        <div class="challenge-doc-main">
          {ruleSections.map((section) => (
            <section class="challenge-rule-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
              <h2 id={`${section.id}-heading`}>{section.title}</h2>
              {section.lead && <p class="challenge-rule-section__lead">{section.lead}</p>}
              <ul class="challenge-rule-list">
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>

              {section.id === 'judging-and-awards' && (
                <div class="challenge-rule-tables">
                  {scoringGroups.map((group) => (
                    <div class="challenge-rule-table">
                      <h3 id={`scoring-${group.id}`}>{group.label}</h3>
                      <table>
                        <caption class="sr-only">{group.label}及判定依据</caption>
                        <thead>
                          <tr>
                            <th scope="col">评分维度</th>
                            <th scope="col">分值</th>
                            <th scope="col">判定依据</th>
                          </tr>
                        </thead>
                        <tbody>
                          {group.dimensions.map((dimension) => (
                            <tr>
                              <th scope="row">{dimension.name}</th>
                              <td>{dimension.weight}</td>
                              <td>{dimension.criteria}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                      <p class="challenge-rule-tiebreaker">{group.tiebreak}</p>
                    </div>
                  ))}
                  <div class="challenge-rule-table">
                    <h3>奖项名额与奖励</h3>
                    <table>
                      <caption class="sr-only">两组奖项名额与奖励</caption>
                      <thead>
                        <tr>
                          <th scope="col">奖项</th>
                          <th scope="col">名额</th>
                          <th scope="col">奖励</th>
                        </tr>
                      </thead>
                      <tbody>
                        {awardRows.map((award) => (
                          <tr>
                            <th scope="row">{award.group} · {award.title}</th>
                            <td>{award.quantity}</td>
                            <td>{award.reward}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    <ul class="challenge-rule-list">
                      {awardNotes.map((note) => <li>{note}</li>)}
                    </ul>
                  </div>
                </div>
              )}
            </section>
          ))}

          <nav class="challenge-doc-nav" aria-label="赛事文档导航">
            <a class="link-arrow" href="/events/">
              <Icon name="arrow-left" size={15} />
              返回活动主页
            </a>
            <a class="link-arrow" href="/events/#register">
              前往报名入口
              <Icon name="arrow-right" size={15} />
            </a>
          </nav>
        </div>

        <aside class="challenge-doc-aside article-toc-aside">
          <ArticleToc headings={tocHeadings} />
          <div class="aside-card aside-card--brand">
            <div class="aside-card__head">
              <Icon name="external-link" size={16} />
              快捷入口
            </div>
            <ul class="challenge-aside-links">
              <li><a href="/events/#schedule">赛程时间线与线上评审 →</a></li>
              <li><a href="/events/#register">腾讯文档报名入口 →</a></li>
              <li><a href="/events/#submit">作品提交说明 →</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
