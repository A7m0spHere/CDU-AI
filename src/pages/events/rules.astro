---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/routes/events.css';
import PageHero from '../../components/PageHero.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import Icon from '../../components/Icon.astro';
import {
  challengeConfig,
  ruleSections,
  scoringDimensions,
  judgeGuardrails,
} from '../../data/challenge';

const tocHeadings = ruleSections.map((section) => ({
  depth: 2,
  slug: section.id,
  text: section.title,
}));
---

<BaseLayout
  title={`完整赛事细则 · ${challengeConfig.title}`}
  description="成都大学首届 AI 创作挑战赛完整赛事细则：参赛资格、1–2 人组队规则、最低交付标准、旧项目增量、数据合规、三阶段提交、100 分评分与学生评委公信力护栏。"
>
  <PageHero
    eyebrow="活动 · 正式细则"
    title="完整赛事细则"
    description={`${challengeConfig.title}执行细则（含参赛资格、组队、交付标准、数据合规、评审机制与申诉条款）。`}
    crumbs={[
      { label: '活动', href: '/events/' },
      { label: '完整赛事细则' },
    ]}
    tone="warm"
  >
    <Fragment slot="actions">
      <a class="btn btn--soft btn--sm" href="/events/">
        <Icon name="arrow-left" size={15} />
        返回活动主页
      </a>
      <a class="btn btn--primary btn--sm" href="/events/#register">
        前往报名入口
        <Icon name="arrow-right" size={15} />
      </a>
      <a class="btn btn--ghost btn--sm" href="/events/ideas/">
        可选选题灵感
      </a>
    </Fragment>

    <Fragment slot="aside">
      <div class="aside-card">
        <div class="aside-card__head">
          <Icon name="shield-check" size={16} />
          文档说明
        </div>
        <dl class="meta-rows">
          <div><dt>适用赛事</dt><dd>{challengeConfig.shortTitle}</dd></div>
          <div><dt>活动日期</dt><dd>{challengeConfig.dates.overall}</dd></div>
          <div><dt>最近更新</dt><dd>{challengeConfig.updatedOn}</dd></div>
          <div><dt>声明</dt><dd>学生社团发起 · 非校官方平台</dd></div>
        </dl>
      </div>
    </Fragment>
  </PageHero>

  <section class="section section--flush-top">
    <div class="container">
      <div class="challenge-doc-layout">
        <div class="challenge-doc-main">
          <div class="notice challenge-doc-banner">
            <Icon name="info" size={17} />
            <p>
              <strong>阅读提示：</strong>本页为正式执行细则。具体项目方向示例单独整理在
              <a class="text-link" href="/events/ideas/">可选选题灵感指南</a>
              中，不构成命题要求或评分偏好；当前具体活动日期、线下场地及部分表单链接处于「待定」占位状态，确认后同步更新。
            </p>
          </div>

          {ruleSections.map((section) => (
            <section class="challenge-rule-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
              <h2 id={`${section.id}-heading`}>{section.title}</h2>
              {section.lead && <p class="challenge-rule-section__lead">{section.lead}</p>}
              <ul class="challenge-rule-list">
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>

              {section.id === 'judging-and-guardrails' && (
                <div class="challenge-guardrail-grid">
                  {judgeGuardrails.map((item, idx) => (
                    <article class="challenge-guardrail-card card">
                      <span class="mono">护栏 0{idx + 1}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </article>
                  ))}
                </div>
              )}

              {section.id === 'demoday-and-awards' && (
                <div
                  tabindex="0"
                  role="region"
                  aria-labelledby="rules-scoring-caption"
                  class="challenge-table-wrap card challenge-rule-table"
                >
                  <table class="challenge-table challenge-table--scoring">
                    <caption id="rules-scoring-caption" class="sr-only">主赛 100 分评分权重一览</caption>
                    <thead>
                      <tr>
                        <th scope="col">评分维度</th>
                        <th scope="col">分值</th>
                        <th scope="col">判定要点</th>
                      </tr>
                    </thead>
                    <tbody>
                      {scoringDimensions.map((dim) => (
                        <tr>
                          <th scope="row">{dim.name}</th>
                          <td><strong>{dim.weight} 分</strong></td>
                          <td>{dim.criteria}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {section.note && (
                <p class="challenge-rule-note">
                  <Icon name="clock" size={14} />
                  <span>{section.note}</span>
                </p>
              )}
            </section>
          ))}

          <nav class="challenge-doc-nav" aria-label="赛事文档导航">
            <a class="link-arrow" href="/events/">
              <Icon name="arrow-left" size={15} />
              返回活动主页与报名入口
            </a>
            <a class="link-arrow" href="/events/ideas/">
              继续看可选选题灵感指南
              <Icon name="arrow-right" size={15} />
            </a>
          </nav>
        </div>

        <aside class="challenge-doc-aside article-toc-aside">
          <ArticleToc headings={tocHeadings} />
          <div class="aside-card aside-card--brand">
            <div class="aside-card__head">
              <Icon name="external-link" size={16} />
              快捷入口
            </div>
            <ul class="challenge-aside-links">
              <li><a href="/events/#register">报名入口与交流群 →</a></li>
              <li><a href="/events/#submit">作品提交三阶段表单 →</a></li>
              <li><a href="/events/#schedule">14 天赛程与 Demo Day →</a></li>
              <li><a href="/events/ideas/">可选选题灵感指南 →</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
