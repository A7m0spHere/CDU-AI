---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/routes/events.css';
import PageHero from '../../components/PageHero.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import Icon from '../../components/Icon.astro';
import {
  challengeConfig,
  ruleSections,
  reviewAndAwardHighlights,
} from '../../data/challenge';

const tocHeadings = ruleSections.map((section) => ({
  depth: 2,
  slug: section.id,
  text: section.title,
}));
---

<BaseLayout
  title={`完整赛事细则 · ${challengeConfig.title}`}
  description="成都大学第八届网络创新大赛——AI创作挑战赛完整赛事细则：双赛道与组队规范、网页公网发布与头图要求、反抄袭与旧项目追溯机制、11月24日–12月4日赛程安排及线上评审说明。"
>
  <PageHero
    eyebrow="活动 · 正式细则"
    title="完整赛事细则"
    description={`${challengeConfig.title}执行细则（含双赛道设置、作品与反抄袭要求、赛程豁免、线上评审及奖项说明）。`}
    crumbs={[
      { label: '活动', href: '/events/' },
      { label: '完整赛事细则' },
    ]}
    tone="warm"
  >
    <Fragment slot="actions">
      <a class="btn btn--soft btn--sm" href="/events/">
        <Icon name="arrow-left" size={15} />
        返回活动主页
      </a>
      <a class="btn btn--primary btn--sm" href="/events/#register">
        前往报名入口
        <Icon name="arrow-right" size={15} />
      </a>
      <a class="btn btn--ghost btn--sm" href="/events/ideas/">
        可选选题灵感
      </a>
    </Fragment>

    <Fragment slot="aside">
      <div class="aside-card">
        <div class="aside-card__head">
          <Icon name="shield-check" size={16} />
          文档说明
        </div>
        <dl class="meta-rows">
          <div><dt>适用赛事</dt><dd>{challengeConfig.shortTitle}</dd></div>
          <div><dt>承办定位</dt><dd>计算机协会首个 AI 赛事</dd></div>
          <div><dt>活动周期</dt><dd>{challengeConfig.dates.overall}</dd></div>
          <div><dt>最近更新</dt><dd>{challengeConfig.updatedOn}</dd></div>
        </dl>
      </div>
    </Fragment>
  </PageHero>

  <section class="section section--flush-top">
    <div class="container">
      <div class="challenge-doc-layout">
        <div class="challenge-doc-main">
          <div class="notice challenge-doc-banner">
            <Icon name="info" size={17} />
            <p>
              <strong>阅读提示：</strong>本页为当前筹备期赛制细则说明。具体项目方向示例另见
              <a class="text-link" href="/events/ideas/">可选选题灵感指南</a>
              ；评分系统指标与具体评奖细则将在 11 月 24 日正式开赛后逐步制定并公开，校级认证与综测认可按最终批复结果为准。
            </p>
          </div>

          {ruleSections.map((section) => (
            <section class="challenge-rule-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
              <h2 id={`${section.id}-heading`}>{section.title}</h2>
              {section.lead && <p class="challenge-rule-section__lead">{section.lead}</p>}
              <ul class="challenge-rule-list">
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>

              {section.id === 'judging-and-awards' && (
                <div class="challenge-guardrail-grid">
                  {reviewAndAwardHighlights.map((item) => (
                    <article class="challenge-guardrail-card card">
                      <span class="mono">{item.step} · {item.badge}</span>
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </article>
                  ))}
                </div>
              )}

              {section.note && (
                <p class="challenge-rule-note">
                  <Icon name="clock" size={14} />
                  <span>{section.note}</span>
                </p>
              )}
            </section>
          ))}

          <nav class="challenge-doc-nav" aria-label="赛事文档导航">
            <a class="link-arrow" href="/events/">
              <Icon name="arrow-left" size={15} />
              返回活动主页与报名入口
            </a>
            <a class="link-arrow" href="/events/ideas/">
              继续看可选选题灵感指南
              <Icon name="arrow-right" size={15} />
            </a>
          </nav>
        </div>

        <aside class="challenge-doc-aside article-toc-aside">
          <ArticleToc headings={tocHeadings} />
          <div class="aside-card aside-card--brand">
            <div class="aside-card__head">
              <Icon name="external-link" size={16} />
              快捷入口
            </div>
            <ul class="challenge-aside-links">
              <li><a href="/events/#requirements">作品要求与反抄袭底线 →</a></li>
              <li><a href="/events/#register">报名入口与交流群 →</a></li>
              <li><a href="/events/#submit">作品提交说明 →</a></li>
              <li><a href="/events/#schedule">赛程时间线与线上评审 →</a></li>
              <li><a href="/events/ideas/">可选选题灵感指南 →</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
