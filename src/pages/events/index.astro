---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/routes/events.css';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import {
  challengeConfig,
  quickFacts,
  competitionTracks,
  workRequirements,
  timelinePhases,
  resolveExternalUrl,
} from '../../data/challenge';

const intentForm = challengeConfig.registration.intentForm;
const intentUrl = intentForm.status === 'open' ? resolveExternalUrl(intentForm.url) : undefined;
const qrImage = challengeConfig.communityGroup.qrImage.trim();

const statusTextMap = {
  upcoming: '待开放',
  open: '开放中',
  closed: '已截止',
} as const;

const subnavItems = [
  { label: '赛程与评审', href: '#schedule' },
  { label: '报名入口', href: '#register' },
  { label: '作品提交', href: '#submit' },
];
---

<BaseLayout
  title={`${challengeConfig.title} · 活动`}
  description="成都大学第八届网络创新大赛——AI创作挑战赛（计协承办的首个 AI 相关赛事）：设新手组与进阶组双赛道，以个人参赛为主，2026年11月24日–12月4日开发与线上评审，12月5日线下 Demo Day。"
>
  <PageHero
    eyebrow={challengeConfig.eyebrow}
    title={challengeConfig.title}
    description={challengeConfig.subtitle}
    crumbs={[{ label: '活动' }]}
    tone="warm"
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href="#register">
        报名入口
        <Icon name="arrow-right" size={16} />
      </a>
      <button
        type="button"
        class="btn btn--soft"
        data-dialog-open="challenge-info-drawer"
        aria-controls="challenge-info-drawer"
        aria-expanded="false"
      >
        <Icon name="layers" size={16} />
        赛道与作品要求
      </button>
      <a class="btn btn--soft" href="/events/rules/">
        完整赛事细则
        <Icon name="arrow-right" size={15} />
      </a>
      <a class="btn btn--ghost" href="#submit">
        作品提交
      </a>
    </Fragment>

    <Fragment slot="aside">
      <button
        type="button"
        class="aside-card aside-card--brand challenge-aside challenge-aside-trigger"
        data-dialog-open="challenge-overview-dialog"
        aria-controls="challenge-overview-dialog"
        aria-expanded="false"
      >
        <span class="challenge-aside-trigger__head">
          <span class="aside-card__head">
            <Icon name="calendar" size={17} />
            <span class="challenge-aside-trigger__label">赛事速览</span>
          </span>
          <span class="challenge-aside-trigger__pill">
            查看详情
            <Icon name="arrow-up-right" size={13} />
          </span>
        </span>
        <span class="status-row challenge-aside-trigger__status">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{challengeConfig.statusBadge}</span>
        </span>
        <span class="challenge-aside-trigger__summary">
          新手组 / 进阶组双赛道 · 个人参赛为主 · AI 项目开发
        </span>
      </button>
    </Fragment>
  </PageHero>

  <nav class="challenge-subnav" aria-label="赛事页面导航">
    <div class="container challenge-subnav__inner">
      <div class="challenge-subnav__links">
        {subnavItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
      <div class="challenge-subnav__pages">
        <button
          type="button"
          class="challenge-subnav__doc challenge-subnav__drawer-btn"
          data-dialog-open="challenge-info-drawer"
          aria-controls="challenge-info-drawer"
          aria-expanded="false"
        >
          <Icon name="layers" size={14} />
          赛道与要求
        </button>
        <a class="challenge-subnav__doc challenge-subnav__doc--primary" href="/events/rules/">
          <Icon name="book-open" size={14} />
          完整赛事细则
        </a>
      </div>
    </div>
  </nav>

  <!-- 赛程与评审（线性时间线） -->
  <section class="section section--flush-top challenge-section" id="schedule" aria-labelledby="schedule-heading">
    <div class="container challenge-linear-container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">赛程与评审</p>
          <h2 id="schedule-heading">从报名到线下 Demo Day 的赛事流程</h2>
          <p class="section-head__desc">
            7–10 天开发期（{challengeConfig.dates.overall}），周二开展线下宣讲，12月4日晚开启线上评审，12月5日开启线下 Demo Day（项目展示与交流）。
          </p>
        </div>
        <a class="btn btn--soft btn--sm" href="/events/rules/">
          查看完整赛事细则
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <ol class="challenge-linear-timeline">
        {timelinePhases.map((phase) => (
          <li class="challenge-linear-step">
            <div class="challenge-linear-step__time">
              <span class="challenge-linear-step__day">{phase.day}</span>
              <span class="challenge-linear-step__tag">{phase.dateLabel}</span>
            </div>
            <div class="challenge-linear-step__body">
              <h3>{phase.stage}</h3>
              <p>{phase.summary}</p>
              <p class="challenge-linear-step__deliverable">{phase.deliverable}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 报名入口与交流群 -->
  <section class="section challenge-section challenge-section--alt" id="register" aria-labelledby="register-heading">
    <div class="container challenge-linear-container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">报名入口</p>
          <h2 id="register-heading">前往飞书填写报名表</h2>
          <p class="section-head__desc">
            报名统一通过外部<strong>{challengeConfig.registration.platform}</strong>收集，所需填写的信息与说明请前往飞书表格内查看。
          </p>
        </div>
        <span class="badge badge--accent">个人参赛为主 · 进阶组原则上 ≤ 2 人</span>
      </div>

      <div class="challenge-register-grid">
        <article class="challenge-register-card card">
          <div class="challenge-register-card__head">
            <div>
              <span class="badge badge--brand">{challengeConfig.registration.platform}</span>
              <h3>官方报名入口</h3>
            </div>
            <span class:list={['challenge-status-pill', `challenge-status-pill--${intentForm.status}`]}>
              {statusTextMap[intentForm.status]}
            </span>
          </div>

          <p class="challenge-register-card__lead">
            点击下方按钮跳转到外部飞书报名表，填写要求与相关说明以表单页面为准。
          </p>

          <div class="challenge-register-card__actions">
            {intentUrl ? (
              <a
                class="btn btn--primary"
                href={intentUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {intentForm.buttonLabel}
                <Icon name="external-link" size={16} />
              </a>
            ) : (
              <button
                type="button"
                class="btn btn--primary"
                data-pending-entry="飞书报名表单链接暂未配置，开放后可在此直接跳转。"
              >
                {intentForm.buttonLabel}
                <Icon name="external-link" size={16} />
              </button>
            )}
          </div>

          {!intentUrl && (
            <p class="challenge-pending-feedback" data-pending-feedback role="status" aria-live="polite" hidden></p>
          )}
        </article>

        <aside class="challenge-group-card card" aria-label="赛事交流群">
          <div class="challenge-group-card__head">
            <span class="badge">{challengeConfig.communityGroup.platform}</span>
            <h3>{challengeConfig.communityGroup.title}</h3>
          </div>
          <p class="challenge-group-card__desc">{challengeConfig.communityGroup.description}</p>

          <div class="challenge-qr-box">
            {qrImage ? (
              <img
                src={qrImage}
                alt={challengeConfig.communityGroup.qrAlt}
                width="220"
                height="220"
                loading="lazy"
              />
            ) : (
              <div class="challenge-qr-placeholder" role="img" aria-label="赛事交流群二维码待补充">
                <Icon name="message-circle" size={32} />
                <strong>群二维码待补充</strong>
                <span>{challengeConfig.communityGroup.placeholderHint}</span>
              </div>
            )}
          </div>

          <dl class="meta-rows challenge-group-meta">
            <div>
              <dt>群号 / 入口</dt>
              <dd>{challengeConfig.communityGroup.groupIdText}</dd>
            </div>
          </dl>

          <a class="link-arrow challenge-group-link" href="/events/rules/#registration-and-teams">
            查看赛道与组队细则
            <Icon name="arrow-right" size={14} />
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- 作品提交（暂留空） -->
  <section class="section challenge-section" id="submit" aria-labelledby="submit-heading">
    <div class="container challenge-linear-container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">作品提交</p>
          <h2 id="submit-heading">作品提交</h2>
        </div>
        <span class="pill">暂未开放 · 敬请期待</span>
      </div>

      <div class="challenge-submit-blank card">
        <p>作品提交页面介绍与提交入口先留空，后续更新同步。</p>
      </div>
    </div>
  </section>

  <!-- 赛事速览弹窗（<dialog> Modal） -->
  <dialog
    id="challenge-overview-dialog"
    class="challenge-modal"
    aria-labelledby="challenge-overview-title"
    {...({ closedby: 'any' } as Record<string, string>)}
  >
    <div class="challenge-modal__panel">
      <header class="challenge-modal__head">
        <div>
          <p class="eyebrow">赛事速览</p>
          <h2 id="challenge-overview-title">{challengeConfig.shortTitle}</h2>
        </div>
        <button
          type="button"
          class="challenge-drawer__close"
          data-dialog-close
          aria-label="关闭赛事速览弹窗"
          autofocus
        >
          <Icon name="close" size={18} />
        </button>
      </header>

      <div class="challenge-modal__body">
        <div class="status-row">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{challengeConfig.statusBadge}</span>
        </div>

        <dl class="meta-rows challenge-modal__rows">
          {quickFacts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>

        <div class="notice">
          <Icon name="info" size={16} />
          <p>{challengeConfig.organizerNote}</p>
        </div>
      </div>

      <footer class="challenge-modal__foot">
        <button
          type="button"
          class="btn btn--soft"
          data-dialog-switch="challenge-info-drawer"
        >
          <Icon name="layers" size={15} />
          赛道与作品要求
        </button>
        <a class="btn btn--primary" href="/events/rules/">
          完整赛事细则
          <Icon name="arrow-right" size={15} />
        </a>
      </footer>
    </div>
  </dialog>

  <!-- 赛道设置与作品要求：右侧滑出抽屉弹窗 -->
  <dialog
    id="challenge-info-drawer"
    class="challenge-drawer"
    aria-labelledby="challenge-drawer-title"
    {...({ closedby: 'any' } as Record<string, string>)}
  >
    <div class="challenge-drawer__panel">
      <header class="challenge-drawer__head">
        <div>
          <p class="eyebrow">赛制速查</p>
          <h2 id="challenge-drawer-title">双赛道、作品要求与反作弊审核</h2>
        </div>
        <button
          type="button"
          class="challenge-drawer__close"
          data-dialog-close
          aria-label="关闭赛事要求抽屉"
          autofocus
        >
          <Icon name="close" size={18} />
        </button>
      </header>

      <div class="challenge-drawer__body">
        <section class="challenge-drawer__group" aria-labelledby="drawer-tracks-title">
          <h3 id="drawer-tracks-title">双赛道设置</h3>
          <div class="challenge-drawer__list">
            {competitionTracks.map((track) => (
              <article class="challenge-drawer__item">
                <div class="challenge-drawer__item-head">
                  <span class="badge badge--brand">{track.code}</span>
                  <strong>{track.title}</strong>
                  <span class="tag">{track.teamRule}</span>
                </div>
                <p>{track.summary} {track.requirement}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="challenge-drawer__group" aria-labelledby="drawer-req-title">
          <h3 id="drawer-req-title">比赛作品要求、审核与反抄袭</h3>
          <div class="challenge-drawer__list">
            {workRequirements.map((item) => (
              <article class:list={['challenge-drawer__item', { 'challenge-drawer__item--warn': item.tone === 'warn' }]}>
                <div class="challenge-drawer__item-head">
                  <span class:list={['badge', item.tone === 'warn' ? 'badge--example' : 'badge--sky']}>
                    {item.badge}
                  </span>
                  <strong>{item.title}</strong>
                </div>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="challenge-drawer__group" aria-labelledby="drawer-resources-title">
          <h3 id="drawer-resources-title">配套学习指南与工具</h3>
          <p class="challenge-drawer__hint">
            官网配套提供 AI 使用教程、学习指南与工具资源库，帮助零基础同学快速上手。
          </p>
          <div class="btn-row">
            <a class="btn btn--soft btn--sm" href="/guide/">学习指南</a>
            <a class="btn btn--ghost btn--sm" href="/tools/">工具资源</a>
          </div>
        </section>
      </div>

      <footer class="challenge-drawer__foot">
        <a class="btn btn--primary" href="/events/rules/">
          阅读完整赛事细则
          <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn btn--soft" href="#register">前往报名入口</a>
      </footer>
    </div>
  </dialog>
</BaseLayout>

<script>
  import '../../scripts/challenge-drawer';
</script>
