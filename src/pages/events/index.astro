---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/routes/events.css';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import {
  challengeConfig,
  quickFacts,
  coreHighlights,
  tracks,
  teamRuleSummary,
  registrationSteps,
  registrationFieldsPreview,
  workScope,
  minimumDeliverables,
  submissionOptions,
  finalMaterials,
  submissionRedlines,
  timelinePhases,
  scoringGroups,
  scoringExecution,
  aiAssistNote,
  awardRows,
  awardNotes,
  challengeFaqs,
  resolveExternalUrl,
} from '../../data/challenge';

const registrationForm = challengeConfig.registration.form;
const registrationUrl =
  registrationForm.status === 'open' ? resolveExternalUrl(registrationForm.url) : undefined;
const registrationQr = challengeConfig.registration.qrImage.trim();

const statusTextMap = {
  upcoming: '待开放',
  open: '开放中',
  closed: '已截止',
} as const;

const subnavItems = [
  { label: '赛事介绍', href: '#intro' },
  { label: '组别与形式', href: '#tracks' },
  { label: '报名入口', href: '#register' },
  { label: '赛程安排', href: '#schedule' },
  { label: '作品要求', href: '#works' },
  { label: '评分与奖项', href: '#scoring' },
  { label: '常见问题', href: '#faq' },
];
---

<BaseLayout
  title={`${challengeConfig.title} · 活动`}
  description="成都大学第八届网络创新大赛 · AI 创作挑战赛：不设统一命题、不要求编程基础，新手组 / 进阶组双轨参赛，10 天做出可运行、可演示的数字作品。含赛制、赛程、评分标准与腾讯文档报名入口。"
>
  <PageHero
    eyebrow={challengeConfig.eyebrow}
    title={challengeConfig.title}
    description={challengeConfig.subtitle}
    crumbs={[{ label: '活动' }]}
    tone="warm"
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href="#register">
        查看报名入口
        <Icon name="arrow-right" size={16} />
      </a>
      <a class="btn btn--soft" href="#schedule">赛程安排</a>
      <a class="btn btn--ghost" href="#scoring">评分与奖项</a>
    </Fragment>

    <Fragment slot="aside">
      <div class="aside-card aside-card--brand challenge-aside">
        <div class="aside-card__head">
          <Icon name="calendar" size={17} />
          赛事速览
        </div>
        <div class="status-row">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{challengeConfig.statusBadge}</span>
        </div>
        <dl class="meta-rows challenge-meta-rows">
          {quickFacts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Fragment>
  </PageHero>

  <nav class="challenge-subnav" aria-label="赛事页面导航">
    <div class="container challenge-subnav__inner">
      <div class="challenge-subnav__links">
        {subnavItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
      <div class="challenge-subnav__pages">
        <a class="challenge-subnav__doc" href="#register">
          <Icon name="external-link" size={14} />
          腾讯文档报名
        </a>
        <a class="challenge-subnav__doc" href="#faq">
          <Icon name="book-open" size={14} />
          参赛答疑
        </a>
      </div>
    </div>
  </nav>

  <!-- 一、赛事介绍 -->
  <section class="section section--flush-top challenge-section" id="intro" aria-labelledby="intro-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">01 · 赛事介绍</p>
          <h2 id="intro-heading">用 AI 把一个想法真正做出来</h2>
          <p class="section-head__desc">
            这是一场面向全校学生的 AI 实践与创作赛事，不是编程考试，也不以代码量、算法难度或商业价值作为评价核心。
            我们更看重你能否在 10 天内借助 AI 把脑中的点子真正跑起来，并通过基本验证说明它确实可用。
          </p>
        </div>
        <span class="pill">赛前公示 · {challengeConfig.dates.competition}</span>
      </div>

      <div class="challenge-highlight-grid">
        {coreHighlights.map((item) => (
          <article class="challenge-highlight card">
            <span class="challenge-highlight__icon">
              <Icon name={item.icon} size={20} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>

      <div class="challenge-guide-strip card">
        <div class="challenge-guide-strip__copy">
          <p class="eyebrow">赛事组织</p>
          <h3>共青团成都大学委员会 · 电子信息与电气工程学院主办</h3>
          <p>
            本届赛事由共青团成都大学委员会、成都大学电子信息与电气工程学院主办，成都大学计算机协会承办。
            {challengeConfig.maintainerNote} 具体教室、时间点与表单入口以选手群和开赛会通知为准。
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--soft btn--sm" href="#tracks">
            查看组别与形式
            <Icon name="arrow-right" size={14} />
          </a>
          <a class="btn btn--ghost btn--sm" href="#works">作品要求</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 二、组别与形式 -->
  <section class="section challenge-section challenge-section--alt" id="tracks" aria-labelledby="tracks-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">02 · 组别与形式</p>
          <h2 id="tracks-heading">新手组与进阶组，同场参赛、分开评奖</h2>
          <p class="section-head__desc">
            零基础和有经验的同学分开竞争，各自评奖。新手组用模板降低起点，进阶组自由选题；两组第一名同样上台领奖。
          </p>
        </div>
        <span class="badge badge--accent">每队最多 2 人 · 新手组仅限个人</span>
      </div>

      <div class="challenge-tracks">
        <div class="challenge-tracks__head">
          <h3>两条轨道，各自的起点与最低要求</h3>
          <p>报名时自行选择组别，组委会在报名截止后 3 天内完成审核；新手组可申请升入进阶组，进阶组不得降入新手组。</p>
        </div>
        <div class="challenge-tracks__grid">
          {tracks.map((track) => (
            <article class="challenge-track-card card">
              <div class="challenge-track-card__top">
                <span class="badge badge--brand">{track.label}</span>
                <h4>{track.shortLabel}</h4>
              </div>
              <p class="challenge-track-card__summary">{track.audience}</p>
              <p class="challenge-track-card__examples">
                <span>参赛形式</span>
                {track.form}
              </p>
              <p class="challenge-track-card__examples">
                <span>作品起点</span>
                {track.startingPoint}
              </p>
              <p class="challenge-track-card__examples">
                <span>最低要求</span>
                {track.minimum}
              </p>
              <p class="challenge-track-card__note">{track.scoring}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="card challenge-mini-rules challenge-team-rules">
        <h4>组队与报名规则</h4>
        <ul>
          {teamRuleSummary.map((rule) => (
            <li>{rule}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 三、报名入口 -->
  <section class="section challenge-section" id="register" aria-labelledby="register-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">03 · 报名入口</p>
          <h2 id="register-heading">腾讯文档报名，填写约 2–3 分钟</h2>
          <p class="section-head__desc">
            报名统一通过<strong>{challengeConfig.registration.platform}</strong>收集。填写报名表后加入选手群，即可参加开赛会并开始准备作品；
            没有项目点子、还没找到队友也可以先报名。
          </p>
        </div>
        <span class="badge badge--accent">报名 11/21 10:00 — 11/24 10:00</span>
      </div>

      <ol class="challenge-stage-bar" aria-label="报名与开赛流程">
        {registrationSteps.map((step, index) => (
          <li class="challenge-stage-step card">
            <div class="challenge-stage-step__head">
              <span class="mono">{step.code}</span>
              <span class="challenge-stage-step__time">{step.timing}</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <span class="challenge-stage-step__num mono" aria-hidden="true">
              0{index + 1}
            </span>
          </li>
        ))}
      </ol>

      <div class="challenge-register-grid">
        <article class="challenge-register-card card">
          <div class="challenge-register-card__head">
            <div>
              <span class="badge badge--brand">{challengeConfig.registration.platform}</span>
              <h3>{registrationForm.title}</h3>
            </div>
            <span class:list={['challenge-status-pill', `challenge-status-pill--${registrationForm.status}`]}>
              {statusTextMap[registrationForm.status]}
            </span>
          </div>

          <p class="challenge-register-card__lead">{registrationForm.purpose}</p>
          {registrationForm.highlight && (
            <p class="challenge-register-card__highlight">
              <Icon name="check" size={15} />
              <span>{registrationForm.highlight}</span>
            </p>
          )}

          <div class="challenge-fields-preview">
            <p class="challenge-fields-preview__label">报名表主要内容（腾讯文档收集表）</p>
            <ul class="challenge-field-list">
              {registrationFieldsPreview.map((field) => (
                <li>
                  <span class="challenge-field-list__name">
                    {field.name}
                    <small class:list={['challenge-req', { 'challenge-req--opt': !field.required }]}>
                      {field.required ? '必填' : '团队填写'}
                    </small>
                  </span>
                  <span class="challenge-field-list__note">{field.note}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="challenge-register-card__actions">
            {registrationUrl ? (
              <a
                class="btn btn--primary"
                href={registrationUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {registrationForm.buttonLabel}
                <Icon name="external-link" size={16} />
              </a>
            ) : (
              <span class="btn btn--soft challenge-btn-pending" aria-disabled="true">
                <Icon name="clock" size={16} />
                {registrationForm.pendingLabel}
              </span>
            )}
          </div>

          <p class="challenge-register-card__timing">
            <Icon name="clock" size={14} />
            <span>
              {registrationForm.dateLabel}
              {!registrationUrl && ' · 入口开放后本页按钮将直接跳转腾讯文档'}
            </span>
          </p>

          <div class="notice challenge-privacy-notice">
            <Icon name="shield-check" size={17} />
            <p>{challengeConfig.registration.privacyNotice}</p>
          </div>
        </article>

        <aside class="challenge-group-card card" aria-label="报名确认与咨询">
          <div class="challenge-group-card__head">
            <span class="badge">报名确认</span>
            <h3>报名后会发生什么</h3>
          </div>
          <p class="challenge-group-card__desc">{challengeConfig.contact.confirmation}</p>

          <div class="challenge-qr-box">
            {registrationQr ? (
              <img
                src={registrationQr}
                alt={challengeConfig.registration.qrAlt}
                width="220"
                height="220"
                loading="lazy"
              />
            ) : (
              <div class="challenge-qr-placeholder" role="img" aria-label="腾讯文档报名二维码">
                <Icon name="message-circle" size={30} />
                <strong>报名二维码</strong>
                <span>请使用手机扫码填写腾讯文档报名表</span>
              </div>
            )}
          </div>

          <dl class="meta-rows challenge-group-meta">
            <div>
              <dt>报名截止</dt>
              <dd>11 月 24 日（周二）10:00</dd>
            </div>
            <div>
              <dt>后续通知</dt>
              <dd>选手群</dd>
            </div>
            <div>
              <dt>报名咨询</dt>
              <dd>选手群 / 组委会联系人</dd>
            </div>
          </dl>

          <p class="challenge-group-card__desc">{challengeConfig.contact.channel}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 四、赛程安排 -->
  <section class="section challenge-section challenge-section--alt" id="schedule" aria-labelledby="schedule-heading">
    <div class="container">
      <div class="blueprint-block challenge-schedule-block">
        <div class="blueprint-block__copy">
          <p class="eyebrow">04 · 赛程安排</p>
          <h2 id="schedule-heading">10 天赛程：线上开发 + 线上评审 + 线下讲解颁奖</h2>
          <p>
            中期检查是轻量节点，提交当前可运行截图或 30 秒录屏 + 进度说明即可；
            无故缺席且未说明的，取消评奖资格。
          </p>
          <div class="blueprint-note">
            <Icon name="calendar" size={16} />
            <span>
              开赛会地点：{challengeConfig.dates.venue}；12/5 线上评审、12/6 下午线下讲解与颁奖，具体安排以选手群通知为准。
            </span>
          </div>
        </div>

        <ol class="blueprint-steps challenge-timeline">
          {timelinePhases.map((phase, index) => (
            <li>
              <div class="challenge-timeline__left">
                <span class="blueprint-steps__marker">{phase.day}</span>
                <span class="challenge-timeline__date">
                  {phase.dateLabel} · {phase.time}
                </span>
              </div>
              <div>
                <h3>{phase.stage}</h3>
                <p>{phase.summary}</p>
                <p class="challenge-timeline__deliverable">{phase.deliverable}</p>
              </div>
              <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 五、作品要求与提交 -->
  <section class="section challenge-section" id="works" aria-labelledby="works-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">05 · 作品要求</p>
          <h2 id="works-heading">至少 1 项可运行的真实功能，拒绝纯 PPT</h2>
          <p class="section-head__desc">
            本届不设海报、视频、纯艺术创作独立赛道。允许原型不完整、外观不成熟、有已知缺陷，但必须有可观察、可验证的实际功能。
          </p>
        </div>
        <span class="pill">作品范围：数字应用与交互作品</span>
      </div>

      <div class="challenge-forms-grid challenge-scope-grid">
        {workScope.map((scope, index) => (
          <article class="challenge-form-card card challenge-scope-card">
            <div class="challenge-form-card__top">
              <span class="badge badge--sky">方向 0{index + 1}</span>
              <Icon name="layers" size={16} />
            </div>
            <h3>{scope}</h3>
          </article>
        ))}
      </div>

      <div class="challenge-deliverables-layout challenge-works-layout">
        <div class="challenge-deliverables card">
          <div class="challenge-deliverables__head">
            <h3>最低交付标准</h3>
            <p>四项至少同时满足，才有主赛评奖资格。</p>
          </div>
          <div class="challenge-deliverables__list">
            {minimumDeliverables.map((item, idx) => (
              <div class="challenge-deliverable-item">
                <span class="mono">0{idx + 1}</span>
                <div>
                  <div class="challenge-deliverable-item__title">
                    <h4>{item.title}</h4>
                    <span class="tag">{item.badge}</span>
                  </div>
                  <p>{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="challenge-submit-side">
          <div class="card challenge-not-required">
            <h4>允许使用 AI、模板与旧项目</h4>
            <ul>
              <li><Icon name="check" size={15} /><span>允许使用 AI 工具、开源项目、模板或此前作品。</span></li>
              <li><Icon name="check" size={15} /><span>须披露项目起点与已有完成度；评分只针对赛期新增/改进部分。</span></li>
              <li><Icon name="check" size={15} /><span>不得将他人现成作品冒充为本次原创成果。</span></li>
            </ul>
          </div>

          <div class="card challenge-redlines">
            <h4>
              <Icon name="alert-triangle" size={16} />
              数据与诚信底线
            </h4>
            <ul>
              <li>不得未经授权获取校内非公开系统数据或绕过访问控制。</li>
              <li>不得在提交材料中泄露 API 密钥、账号密码或他人隐私。</li>
              <li>伪造运行结果、用户测试或开发记录的，降档或取消评奖资格。</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="challenge-forms-grid challenge-submission-grid">
        {submissionOptions.map((option) => (
          <article class="challenge-form-card card">
            <div class="challenge-form-card__top">
              <span class="badge badge--brand">{option.code} · 提交方式</span>
              <span class="tag">评分平等</span>
            </div>
            <h3>{option.title}</h3>
            <p>{option.summary}</p>
            <p class="challenge-form-card__callout">{option.note}</p>
          </article>
        ))}
      </div>

      <div class="challenge-deliverables-layout challenge-works-layout">
        <div class="challenge-deliverables card">
          <div class="challenge-deliverables__head">
            <h3>最终作品提交材料</h3>
            <p>截止时间：{challengeConfig.dates.submission}，逾期视为弃赛。</p>
          </div>
          <div class="challenge-deliverables__list">
            {finalMaterials.map((item, idx) => (
              <div class="challenge-deliverable-item">
                <span class="mono">0{idx + 1}</span>
                <div>
                  <div class="challenge-deliverable-item__title">
                    <h4>{item.title}</h4>
                    <span class="tag">{item.badge}</span>
                  </div>
                  <p>{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="challenge-submit-side">
          <div class="card challenge-redlines">
            <h4>
              <Icon name="alert-triangle" size={16} />
              提交红线
            </h4>
            <ul>
              {submissionRedlines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 六、评分与奖项 -->
  <section class="section challenge-section challenge-section--alt" id="scoring" aria-labelledby="scoring-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">06 · 评分与奖项</p>
          <h2 id="scoring-heading">两套 100 分评分表，按组别分开评奖</h2>
          <p class="section-head__desc">
            材料初评占 40%，现场 Demo 与答辩占 60%；每位评委独立打分取平均分。两组的同分排序规则不同，详见各表下方说明。
          </p>
        </div>
        <a class="link-arrow section-head__link" href="#awards">
          查看奖项设置
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <div class="challenge-scoring-groups">
        {scoringGroups.map((group) => (
          <section class="challenge-scoring-group" aria-labelledby={`scoring-${group.id}-heading`}>
            <div class="challenge-scoring-group__head">
              <div>
                <span class="badge badge--brand">{group.tag}</span>
                <h3 id={`scoring-${group.id}-heading`}>{group.label}</h3>
              </div>
              <p>{group.summary}</p>
            </div>

            <div
              tabindex="0"
              role="region"
              aria-labelledby={`scoring-${group.id}-caption`}
              class="challenge-table-wrap card"
            >
              <table class="challenge-table challenge-table--scoring">
                <caption id={`scoring-${group.id}-caption`} class="sr-only">
                  {group.label}评分标准
                </caption>
                <thead>
                  <tr>
                    <th scope="col">评分维度</th>
                    <th scope="col">分值权重</th>
                    <th scope="col">主要判断依据</th>
                  </tr>
                </thead>
                <tbody>
                  {group.dimensions.map((dim) => (
                    <tr>
                      <th scope="row">{dim.name}</th>
                      <td class="challenge-table__score">
                        <div class="score-meter">
                          <strong>{dim.weight} 分</strong>
                          <span class="score-meter__bar" aria-hidden="true">
                            <span style={`width: ${Math.round((dim.weight / 40) * 100)}%`}></span>
                          </span>
                        </div>
                      </td>
                      <td>{dim.criteria}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="challenge-tiebreaker">
              <Icon name="info" size={16} />
              <span><strong>同分排序：</strong>{group.tiebreak}</span>
            </p>
          </section>
        ))}
      </div>

      <div class="challenge-guardrail-grid challenge-scoring-execution">
        {scoringExecution.map((item, idx) => (
          <article class="challenge-guardrail-card card">
            <span class="mono">规则 0{idx + 1}</span>
            <p>{item}</p>
          </article>
        ))}
      </div>

      <div class="notice challenge-ai-note">
        <Icon name="shield-check" size={17} />
        <p><strong>评审说明：</strong>{aiAssistNote}</p>
      </div>

      <div class="challenge-awards" id="awards">
        <div class="challenge-awards__head">
          <h3>奖项设置</h3>
          <p>新手组、进阶组分开评奖，互不占用名额；获奖者颁发校级证书与奖品。</p>
        </div>

        <div
          tabindex="0"
          role="region"
          aria-labelledby="awards-table-caption"
          class="challenge-table-wrap card challenge-awards-table"
        >
          <table class="challenge-table challenge-table--awards">
            <caption id="awards-table-caption" class="sr-only">新手组与进阶组奖项设置</caption>
            <thead>
              <tr>
                <th scope="col">奖项</th>
                <th scope="col">数量</th>
                <th scope="col">奖励</th>
              </tr>
            </thead>
            <tbody>
              {awardRows.map((award) => (
                <tr>
                  <th scope="row">{award.group} · {award.title}</th>
                  <td>{award.quantity}</td>
                  <td>{award.reward}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <ul class="challenge-award-notes">
          {awardNotes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 七、常见问题 -->
  <section class="section challenge-section" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">07 · 常见问题</p>
          <h2 id="faq-heading">参赛前你可能关心的问题</h2>
          <p class="section-head__desc">
            更多规则细节可在开赛会现场咨询，或通过选手群联系组委会；赛程与表单入口如有调整，以选手群通知为准。
          </p>
        </div>
      </div>

      <div class="challenge-faq">
        {challengeFaqs.map((item) => (
          <details class="challenge-faq__item card">
            <summary class="challenge-faq__summary">
              <span>{item.question}</span>
            </summary>
            <div class="challenge-faq__body">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="events-cta challenge-bottom-cta">
        <div>
          <p class="eyebrow">准备开始</p>
          <h2>报名开放中 · 11 月 24 日 10:00 截止</h2>
          <p>
            {challengeConfig.organizerNote}。{challengeConfig.maintainerNote}
            本页最后更新于 {challengeConfig.updatedOn}。
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="#register">
            回到报名入口
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn--soft" href="/guide/">学习指南</a>
          <a class="btn btn--ghost" href="/tools/">工具资源</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
