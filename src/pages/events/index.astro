---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/routes/events.css';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import {
  challengeConfig,
  quickFacts,
  coreHighlights,
  workCategories,
  admissionSteps,
  registrationFieldsPreview,
  teamRuleSummary,
  submissionForms,
  finalDeliverables,
  notRequiredItems,
  submissionRedlines,
  timelinePhases,
  demoDaySessions,
  scoringDimensions,
  tiebreakerNote,
  awardsList,
  challengeFaqs,
  resolveExternalUrl,
} from '../../data/challenge';

const intentForm = challengeConfig.registration.intentForm;
const teamConfirmForm = challengeConfig.registration.teamConfirmForm;
const intentUrl = intentForm.status === 'open' ? resolveExternalUrl(intentForm.url) : undefined;
const teamConfirmUrl = teamConfirmForm.status === 'open' ? resolveExternalUrl(teamConfirmForm.url) : undefined;
const qrImage = challengeConfig.communityGroup.qrImage.trim();

const statusTextMap = {
  upcoming: '待开放',
  open: '开放中',
  closed: '已截止',
} as const;

const subnavItems = [
  { label: '赛事介绍', href: '#intro' },
  { label: '报名入口', href: '#register' },
  { label: '作品提交', href: '#submit' },
  { label: '14 天赛程', href: '#schedule' },
  { label: '评分与奖项', href: '#scoring' },
  { label: '常见疑问', href: '#faq' },
];
---

<BaseLayout
  title={`${challengeConfig.title} · 活动`}
  description="成都大学首届 AI 创作挑战赛：不限专业、零编程基础可参与，1–2 人组队，14 天做出真实可运行数字作品。包含赛事介绍、飞书报名入口、作品提交说明、赛程与评分细则。"
>
  <PageHero
    eyebrow={challengeConfig.eyebrow}
    title={challengeConfig.title}
    description={challengeConfig.subtitle}
    crumbs={[{ label: '活动' }]}
    tone="warm"
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href="#register">
        报名入口
        <Icon name="arrow-right" size={16} />
      </a>
      <a class="btn btn--soft" href="#submit">
        作品提交说明
      </a>
      <a class="btn btn--ghost" href="/events/rules/">
        完整赛事细则
        <Icon name="arrow-right" size={15} />
      </a>
    </Fragment>

    <Fragment slot="aside">
      <div class="aside-card aside-card--brand challenge-aside">
        <div class="aside-card__head">
          <Icon name="calendar" size={17} />
          赛事速览
        </div>
        <div class="status-row">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{challengeConfig.statusBadge}</span>
        </div>
        <dl class="meta-rows challenge-meta-rows">
          {quickFacts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Fragment>
  </PageHero>

  <nav class="challenge-subnav" aria-label="赛事页面导航">
    <div class="container challenge-subnav__inner">
      <div class="challenge-subnav__links">
        {subnavItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
      <div class="challenge-subnav__pages">
        <a class="challenge-subnav__doc" href="/events/rules/">
          <Icon name="book-open" size={14} />
          完整细则
        </a>
        <a class="challenge-subnav__doc" href="/events/ideas/">
          <Icon name="spark" size={14} />
          选题灵感
        </a>
      </div>
    </div>
  </nav>

  <!-- 一、赛事介绍 -->
  <section class="section section--flush-top challenge-section" id="intro" aria-labelledby="intro-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">01 · 赛事介绍</p>
          <h2 id="intro-heading">把想法做成可运行、可体验的数字作品</h2>
          <p class="section-head__desc">
            这是一场实践与学习导向的校园限时创作赛事，而不是创业融资路演或算法竞赛。我们更看重你能否在 14 天内借助 AI
            把脑中的点子真正跑起来，并通过恰当的测试不断迭代。
          </p>
        </div>
        <span class="pill">具体日期待定 · 规则已发布</span>
      </div>

      <div class="challenge-highlight-grid">
        {coreHighlights.map((item) => (
          <article class="challenge-highlight card">
            <span class="challenge-highlight__icon">
              <Icon name={item.icon} size={20} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>

      <div class="challenge-tracks">
        <div class="challenge-tracks__head">
          <h3>两类作品在主赛中平等参赛</h3>
          <p>评委只看 AI 是否被合理使用、作品是否真实可用，不凭“有没有接大模型 API”额外加分。</p>
        </div>
        <div class="challenge-tracks__grid">
          {workCategories.map((cat) => (
            <article class="challenge-track-card card">
              <div class="challenge-track-card__top">
                <span class="badge badge--brand">{cat.code}</span>
                <h4>{cat.title}</h4>
              </div>
              <p class="challenge-track-card__summary">{cat.summary}</p>
              <p class="challenge-track-card__examples">
                <span>常见形态</span>
                {cat.examples}
              </p>
              <p class="challenge-track-card__note">{cat.note}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="challenge-guide-strip card">
        <div class="challenge-guide-strip__copy">
          <p class="eyebrow">还没想好做什么或如何上手？</p>
          <h3>选题灵感与新手学习资源</h3>
          <p>
            我们按资源依赖度整理了「可选选题灵感指南」，帮助你避开高依赖踩坑；零基础同学也可以先参考站内学习指南与工具目录。
            比赛保持工具中立，不要求使用任何指定教程、平台或厂商产品。
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--soft btn--sm" href="/events/ideas/">
            查看可选选题灵感
            <Icon name="arrow-right" size={14} />
          </a>
          <a class="btn btn--ghost btn--sm" href="/guide/">学习指南</a>
          <a class="btn btn--ghost btn--sm" href="/tools/">工具资源</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 二、报名入口与交流群 -->
  <section class="section challenge-section challenge-section--alt" id="register" aria-labelledby="register-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">02 · 报名入口</p>
          <h2 id="register-heading">两步报名入场，先来再组队</h2>
          <p class="section-head__desc">
            报名统一通过外部<strong>{challengeConfig.registration.platform}</strong>收集。没有项目点子、还没找到队友也可以先完成个人意向报名，入群后再自由组队或以单人队参赛。
          </p>
        </div>
        <span class="badge badge--accent">每队 1–2 人 · 鼓励个人参赛</span>
      </div>

      <ol class="challenge-stage-bar" aria-label="三阶段准入流程">
        {admissionSteps.map((step, index) => (
          <li class="challenge-stage-step card">
            <div class="challenge-stage-step__head">
              <span class="mono">{step.code}</span>
              <span class="challenge-stage-step__time">时间：{step.timing}</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <span class="challenge-stage-step__num mono" aria-hidden="true">0{index + 1}</span>
          </li>
        ))}
      </ol>

      <div class="challenge-register-grid">
        <article class="challenge-register-card card">
          <div class="challenge-register-card__head">
            <div>
              <span class="badge badge--brand">{intentForm.code} · {challengeConfig.registration.platform}</span>
              <h3>{intentForm.title}</h3>
            </div>
            <span class:list={['challenge-status-pill', `challenge-status-pill--${intentForm.status}`]}>
              {statusTextMap[intentForm.status]}
            </span>
          </div>

          <p class="challenge-register-card__lead">{intentForm.purpose}</p>
          {intentForm.highlight && (
            <p class="challenge-register-card__highlight">
              <Icon name="check" size={15} />
              <span>{intentForm.highlight}</span>
            </p>
          )}

          <div class="challenge-fields-preview">
            <p class="challenge-fields-preview__label">意向报名表字段预览（轻量收集）</p>
            <ul class="challenge-field-list">
              {registrationFieldsPreview.map((field) => (
                <li>
                  <span class="challenge-field-list__name">
                    {field.name}
                    <small class:list={['challenge-req', { 'challenge-req--opt': !field.required }]}>
                      {field.required ? '必填' : '选填'}
                    </small>
                  </span>
                  <span class="challenge-field-list__note">{field.note}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="challenge-register-card__actions">
            {intentUrl ? (
              <a
                class="btn btn--primary"
                href={intentUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {intentForm.buttonLabel}
                <Icon name="external-link" size={16} />
              </a>
            ) : (
              <span class="btn btn--soft challenge-btn-pending" aria-disabled="true">
                <Icon name="external-link" size={16} />
                {intentForm.pendingLabel}
              </span>
            )}

            {teamConfirmUrl ? (
              <a
                class="btn btn--soft"
                href={teamConfirmUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {teamConfirmForm.buttonLabel}
                <Icon name="external-link" size={15} />
              </a>
            ) : (
              <span class="btn btn--ghost challenge-btn-pending" aria-disabled="true">
                {teamConfirmForm.pendingLabel}（阶段 B）
              </span>
            )}
          </div>

          <p class="challenge-register-card__timing">
            <Icon name="clock" size={14} />
            <span>
              意向报名：{challengeConfig.dates.registration} · 组队确认截止：{challengeConfig.dates.teamConfirm}
              {!intentUrl && '（飞书表单链接确定后将直接开放跳转）'}
            </span>
          </p>

          <div class="challenge-mini-rules">
            <h4>组队核心规则</h4>
            <ul>
              {teamRuleSummary.map((rule) => (
                <li>{rule}</li>
              ))}
            </ul>
          </div>

          <div class="notice challenge-privacy-notice">
            <Icon name="shield-check" size={17} />
            <p>{challengeConfig.registration.privacyNotice}</p>
          </div>
        </article>

        <aside class="challenge-group-card card" aria-label="赛事交流群">
          <div class="challenge-group-card__head">
            <span class="badge">{challengeConfig.communityGroup.platform}</span>
            <h3>{challengeConfig.communityGroup.title}</h3>
          </div>
          <p class="challenge-group-card__desc">{challengeConfig.communityGroup.description}</p>

          <div class="challenge-qr-box">
            {qrImage ? (
              <img
                src={qrImage}
                alt={challengeConfig.communityGroup.qrAlt}
                width="220"
                height="220"
                loading="lazy"
              />
            ) : (
              <div class="challenge-qr-placeholder" role="img" aria-label="赛事交流群二维码待补充">
                <Icon name="message-circle" size={32} />
                <strong>群二维码待补充</strong>
                <span>{challengeConfig.communityGroup.placeholderHint}</span>
              </div>
            )}
          </div>

          <dl class="meta-rows challenge-group-meta">
            <div>
              <dt>群号 / 入口</dt>
              <dd>{challengeConfig.communityGroup.groupIdText}</dd>
            </div>
            <div>
              <dt>入群用途</dt>
              <dd>赛期通知 · 自由寻队友 · 技术答疑</dd>
            </div>
          </dl>

          <a class="link-arrow challenge-group-link" href="/events/rules/#registration-and-teams">
            查看完整组队与人员变动细则
            <Icon name="arrow-right" size={14} />
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- 三、作品提交入口 -->
  <section class="section challenge-section" id="submit" aria-labelledby="submit-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">03 · 作品提交</p>
          <h2 id="submit-heading">三张独立表单，用唯一队伍编号串联全程</h2>
          <p class="section-head__desc">
            作品提交入口目前暂定，具体链接将在开赛前于本页与交流群公布。全流程以组委会分配的<strong>唯一队伍编号（如 CDUAI-007）</strong>作为主键，分三个节点提交对应材料。
          </p>
        </div>
        <span class="pill">提交入口暂定 · 规范已明确</span>
      </div>

      <div class="challenge-forms-grid">
        {submissionForms.map((form) => {
          const safeUrl = form.status === 'open' ? resolveExternalUrl(form.url) : undefined;
          return (
            <article class="challenge-form-card card">
              <div class="challenge-form-card__top">
                <span class="badge badge--sky">{form.code}</span>
                <span class:list={['challenge-status-pill', `challenge-status-pill--${form.status}`]}>
                  {statusTextMap[form.status]}
                </span>
              </div>
              <p class="challenge-form-card__stage">{form.stageLabel}</p>
              <h3>{form.title}</h3>
              <p class="challenge-form-card__date">
                <Icon name="calendar" size={14} />
                <span>开放节点：{form.dateLabel}</span>
              </p>
              <div class="challenge-form-card__block">
                <span>核心收集</span>
                <p>{form.collects}</p>
              </div>
              <div class="challenge-form-card__block">
                <span>评审用途</span>
                <p>{form.purpose}</p>
              </div>
              {form.highlight && (
                <p class="challenge-form-card__callout">{form.highlight}</p>
              )}
              <div class="challenge-form-card__foot">
                {safeUrl ? (
                  <a
                    class="btn btn--primary btn--sm"
                    href={safeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {form.buttonLabel}
                    <Icon name="external-link" size={14} />
                  </a>
                ) : (
                  <span class="btn btn--soft btn--sm challenge-btn-pending" aria-disabled="true">
                    {form.pendingLabel}
                  </span>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <div class="challenge-deliverables-layout">
        <div class="challenge-deliverables card">
          <div class="challenge-deliverables__head">
            <h3>最终作品提交材料清单（表 3）</h3>
            <p>推荐提交简洁、可核查的材料，避免冗长包装。</p>
          </div>
          <div class="challenge-deliverables__list">
            {finalDeliverables.map((item, idx) => (
              <div class="challenge-deliverable-item">
                <span class="mono">0{idx + 1}</span>
                <div>
                  <div class="challenge-deliverable-item__title">
                    <h4>{item.title}</h4>
                    <span class="tag">{item.badge}</span>
                  </div>
                  <p>{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="challenge-submit-side">
          <div class="card challenge-not-required">
            <h4>明确不强制提供</h4>
            <ul>
              {notRequiredItems.map((item) => (
                <li>
                  <Icon name="check" size={15} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="card challenge-redlines">
            <h4>
              <Icon name="alert-triangle" size={16} />
              交付与补正红线
            </h4>
            <ul>
              {submissionRedlines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 四、14 天赛程与 Demo Day -->
  <section class="section challenge-section challenge-section--alt" id="schedule" aria-labelledby="schedule-heading">
    <div class="container">
      <div class="blueprint-block challenge-schedule-block">
        <div class="blueprint-block__copy">
          <p class="eyebrow">04 · 14 天赛程</p>
          <h2 id="schedule-heading">线上自由开发 + 全员线下 Demo Day</h2>
          <p>
            不强制连续熬夜或全天驻场。只要作品达到最低交付标准（至少一项真实可运行功能、非纯 PPT），全部入围 D14 线下展示，不设中途淘汰。
          </p>
          <div class="blueprint-note">
            <Icon name="calendar" size={16} />
            <span>具体日历日期与校内场地目前<strong>待定</strong>，确认后将按 D1–D14 节点同步更新到本表。</span>
          </div>
        </div>

        <ol class="blueprint-steps challenge-timeline">
          {timelinePhases.map((phase, index) => (
            <li>
              <div class="challenge-timeline__left">
                <span class="blueprint-steps__marker">{phase.day}</span>
                <span class="challenge-timeline__date">{phase.dateLabel}</span>
              </div>
              <div>
                <h3>{phase.stage}</h3>
                <p>{phase.summary}</p>
                <p class="challenge-timeline__deliverable">{phase.deliverable}</p>
              </div>
              <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="challenge-demoday">
        <div class="challenge-demoday__head">
          <div>
            <p class="eyebrow">D14 线下亮点</p>
            <h3>全员 Demo Day 执行节奏</h3>
          </div>
          <span class="badge badge--brand">开场 60 秒内进入真实可运行界面</span>
        </div>

        <div class="challenge-demoday__grid">
          {demoDaySessions.map((session) => (
            <article class="challenge-demoday-card card">
              <div class="challenge-demoday-card__top">
                <span class="mono">{session.step}</span>
                <span class="tag">{session.duration}</span>
              </div>
              <h4>{session.title}</h4>
              <p>{session.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 五、评分标准与奖项 -->
  <section class="section challenge-section" id="scoring" aria-labelledby="scoring-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">05 · 评分与奖项</p>
          <h2 id="scoring-heading">100 分评审维度与奖项设置</h2>
          <p class="section-head__desc">
            D13 线上初评先行完成前五项（95 分基线），D14 结合现场实操与 Open Demo 上手体验补填「展示与表达（5 分）」并锁定最终成绩。
          </p>
        </div>
        <a class="link-arrow section-head__link" href="/events/rules/#judging-and-guardrails">
          查看评委公信力护栏
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <div
        tabindex="0"
        role="region"
        aria-labelledby="scoring-table-caption"
        class="challenge-table-wrap card"
      >
        <table class="challenge-table challenge-table--scoring">
          <caption id="scoring-table-caption" class="sr-only">成都大学首届 AI 创作挑战赛 100 分评分标准</caption>
          <thead>
            <tr>
              <th scope="col">评分维度</th>
              <th scope="col">分值权重</th>
              <th scope="col">主要判断依据</th>
            </tr>
          </thead>
          <tbody>
            {scoringDimensions.map((dim) => (
              <tr>
                <th scope="row">{dim.name}</th>
                <td class="challenge-table__score">
                  <div class="score-meter">
                    <strong>{dim.weight} 分</strong>
                    <span class="score-meter__bar" aria-hidden="true">
                      <span style={`width: ${Math.round((dim.weight / 30) * 100)}%`}></span>
                    </span>
                  </div>
                </td>
                <td>{dim.criteria}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="challenge-tiebreaker">
        <Icon name="info" size={16} />
        <span><strong>同分排序规则：</strong>{tiebreakerNote}</span>
      </p>

      <div class="challenge-awards" id="awards">
        <div class="challenge-awards__head">
          <h3>奖项设置</h3>
          <p>奖金与证书发放形式将按校内财务及活动管理规定执行。</p>
        </div>
        <div class="challenge-awards__grid">
          {awardsList.map((award) => (
            <article class:list={['challenge-award-card card', { 'challenge-award-card--special': award.independent }]}>
              <div class="challenge-award-card__top">
                <span class:list={['badge', award.independent ? 'badge--example' : 'badge--brand']}>
                  {award.badge}
                </span>
                <strong class="challenge-award-card__reward">{award.reward}</strong>
              </div>
              <h4>{award.title}</h4>
              <p>{award.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 六、常见疑问与完整细则入口 -->
  <section class="section challenge-section challenge-section--alt" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">06 · 常见疑问</p>
          <h2 id="faq-heading">参赛前你可能关心的问题</h2>
          <p class="section-head__desc">更多完整条款（含旧项目增量认定、数据合规红线、评委回避与 48 小时申诉机制）请查阅完整赛事细则。</p>
        </div>
      </div>

      <div class="challenge-faq">
        {challengeFaqs.map((item) => (
          <details class="challenge-faq__item card">
            <summary class="challenge-faq__summary">
              <span>{item.question}</span>
            </summary>
            <div class="challenge-faq__body">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="events-cta challenge-bottom-cta">
