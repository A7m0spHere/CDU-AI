---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/routes/events.css';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import {
  challengeConfig,
  dependencyTiers,
  ideaDirections,
  scopeShrinkExamples,
} from '../../data/challenge';
---

<BaseLayout
  title={`可选选题灵感指南 · ${challengeConfig.title}`}
  description="成都大学第八届网络创新大赛——AI创作挑战赛可选选题灵感指南：聚焦校园 AI 网页开发，提供新手组参考模板改进思路与进阶组网页方向参考，不作为赛题限制。"
>
  <PageHero
    eyebrow="活动 · 灵感参考"
    title="可选选题灵感指南"
    description="本届比赛聚焦校园 AI 网页开发，不设统一命题。以下方向仅用于帮初次参赛的同学寻找切入点，不构成赛题限制。"
    crumbs={[
      { label: '活动', href: '/events/' },
      { label: '可选选题灵感指南' },
    ]}
    tone="sky"
  >
    <Fragment slot="actions">
      <a class="btn btn--soft btn--sm" href="/events/">
        <Icon name="arrow-left" size={15} />
        返回活动主页
      </a>
      <a class="btn btn--ghost btn--sm" href="/events/rules/">
        查看完整赛事细则
        <Icon name="arrow-right" size={15} />
      </a>
    </Fragment>
  </PageHero>

  <section class="section section--flush-top">
    <div class="container">
      <div class="notice challenge-doc-banner">
        <Icon name="info" size={17} />
        <p>
          <strong>选题与原创说明：</strong>新手组可基于官方参考模板完成至少一项有意义的改进，进阶组可自由设计与开发；所有作品均须发布至公网并自制核心功能头图，严禁直接套壳或搬运源码。
        </p>
      </div>

      <div class="challenge-ideas-block" id="dependency">
        <div class="section-head">
          <div class="section-head__copy">
            <p class="eyebrow">01 · 按外部依赖度选择网页切入点</p>
            <h2>新手优先做“低依赖、公网稳定可测”的最小网页</h2>
            <p class="section-head__desc">
              在 7–10 天开发期（{challengeConfig.dates.overall}）里，外部账号限额、跨域配置或受限校内接口往往是最容易卡住进度的风险点。选对依赖级别，能把精力留给交互体验、核心亮点与头图打磨。
            </p>
          </div>
        </div>

        <div class="challenge-tier-grid">
          {dependencyTiers.map((tier) => (
            <article class="challenge-tier-card card">
              <div class="challenge-tier-card__top">
                <h3>{tier.level}</h3>
                <span
                  class:list={[
                    'badge',
                    tier.tone === 'brand' && 'badge--brand',
                    tier.tone === 'sky' && 'badge--sky',
                    tier.tone === 'warn' && 'badge--example',
                  ]}
                >
                  {tier.tag}
                </span>
              </div>
              <p class="challenge-tier-card__examples">
                <span>示例方向</span>
                {tier.examples}
              </p>
              <p class="challenge-tier-card__tip">{tier.tip}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="challenge-ideas-block" id="directions">
        <div class="section-head">
          <div class="section-head__copy">
            <p class="eyebrow">02 · 六类校园 AI 网页创作方向</p>
            <h2>从兴趣、学习或日常小麻烦出发</h2>
            <p class="section-head__desc">无论是新手组在参考模板上增加实用模块，还是进阶组独立构建交互网页，都可以从以下场景切入。</p>
          </div>
        </div>

        <div class="challenge-direction-grid">
          {ideaDirections.map((dir) => (
            <article class="challenge-direction-card card">
              <div class="challenge-direction-card__head">
                <span class="challenge-highlight__icon">
                  <Icon name={dir.icon} size={19} />
                </span>
                <div>
                  <h3>{dir.title}</h3>
                  <p>{dir.subtitle}</p>
                </div>
              </div>
              <ul>
                {dir.examples.map((example) => (
                  <li>{example}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>

      <div class="challenge-ideas-block" id="scope">
        <div class="section-head">
          <div class="section-head__copy">
            <p class="eyebrow">03 · 合理收敛范围</p>
            <h2>把“大想法”收敛成 7–10 天能上线公网的真网页</h2>
            <p class="section-head__desc">
              线上评审看重实际完成度、合规性与独特创意亮点。与其堆砌打不开的空页面，不如把一个高频小场景做到顺滑可测，并做好核心功能头图展示。
            </p>
          </div>
        </div>

        <div class="challenge-scope-grid">
          {scopeShrinkExamples.map((item, idx) => (
            <article class="challenge-scope-card card">
              <span class="mono">案例 0{idx + 1}</span>
              <div class="challenge-scope-card__row challenge-scope-card__row--before">
                <span>容易踩坑的范围</span>
                <p>{item.before}</p>
              </div>
              <div class="challenge-scope-card__row challenge-scope-card__row--after">
                <span>推荐收敛做法</span>
                <p>{item.after}</p>
              </div>
              <p class="challenge-scope-card__why">{item.why}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="events-cta challenge-bottom-cta">
        <div>
          <p class="eyebrow">准备开始动手？</p>
          <h2>回到活动页查看报名，或先浏览站内教程</h2>
          <p>
            官网同步配套 AI 使用教程、学习指南与工具资源库，可作为入门与选型参考。
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/events/#register">
            前往报名入口
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn--soft" href="/guide/">学习指南</a>
          <a class="btn btn--soft" href="/tools/">工具资源</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
