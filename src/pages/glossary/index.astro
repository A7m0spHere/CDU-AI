---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyContent from '../../components/EmptyContent.astro';
import { getCollection } from 'astro:content';
import { glossaryCategories } from '../../data/glossary';
import { repository } from '../../data/site';
import '../../styles/glossary.css';

const categoryOrder = new Map(glossaryCategories.map((item, index) => [item.id, index]));
const terms = (await getCollection('glossary')).sort(
  (a, b) =>
    (categoryOrder.get(a.data.category) ?? 0) - (categoryOrder.get(b.data.category) ?? 0) ||
    a.data.order - b.data.order,
);

const categoryCount = (id: string) => terms.filter((term) => term.data.category === id).length;
const total = terms.length;
const isEmpty = total === 0;
const lastUpdated = terms.map((term) => term.data.updated).sort().at(-1);
const contributeLinks = [
  { label: '参与共建', href: '/about/#contribute' },
  { label: '贡献指南', href: `${repository.url}/blob/main/CONTRIBUTING.md`, external: true },
];
---

<BaseLayout
  title="AI 术语表"
  description="把常见 AI 术语讲清楚：每个词一篇白话解释，配校园场景示例，点进去看完整说明。"
>
  <div class="wiki-shell">
    <div class="container">
      <PageHeader
        index="02"
        eyebrow="术语表"
        title="AI 术语表"
        lede="把常见的 AI 术语讲清楚。每个词都有一篇白话解释：先打个比方，再说它怎么运作、什么时候会碰到、哪些地方容易误解。点开卡片就能看全文。"
        meta={[
          { label: total > 0 ? total + ' 条' : '内容准备中', tone: total > 0 ? 'brand' : 'warn' },
          { label: '人工核校后发布' },
        ]}
        crumbs={[{ label: '术语表' }]}
      />

      {isEmpty && (
        <EmptyContent
          icon="book-open"
          title="术语内容正在准备中"
          description="第一批术语正在整理与人工核校中。每个词都会附上白话解释、校园场景示例和实际审校状态。"
          links={contributeLinks}
        />
      )}

      {!isEmpty && (
      <div class="catalog-layout glossary-layout" data-filter-root data-reveal>
        <aside class="catalog-sidebar glossary-sidebar" aria-label="术语筛选">
          <label class="sr-only" for="glossary-search">搜索术语、别名或场景</label>
          <div class="search-field">
            <Icon name="search" size={18} />
            <input
              id="glossary-search"
              type="search"
              placeholder="搜索术语或场景…"
              autocomplete="off"
              data-filter-search
            />
          </div>

          <nav class="catalog-nav" aria-label="按分类筛选">
            <div class="catalog-nav__head">
              <span>分类</span>
              <span class="filter-count">{total} 条</span>
            </div>
            <div class="filter-chips filter-chips--vertical" role="group" aria-label="按分类筛选">
              <button class="filter-chip" type="button" data-filter-value="all" aria-pressed="true">
                全部术语
                <span class="filter-chip__count">{total}</span>
              </button>
              {glossaryCategories.map((category) => (
                <button class="filter-chip" type="button" data-filter-value={category.id} aria-pressed="false">
                  {category.name}
                  <span class="filter-chip__count">{categoryCount(category.id)}</span>
                </button>
              ))}
            </div>
          </nav>

          <p class="catalog-sidebar__note">
            <Icon name="info" size={14} />
            同一个概念可能有多个叫法；以实际产品与官方文档为准。
          </p>
        </aside>

        <div class="catalog-main glossary-main">
          <div class="results-bar">
            <p aria-live="polite">显示 <strong data-filter-count>{total}</strong> 个术语</p>
            <button class="clear-filters" type="button" data-clear-filters hidden>清除筛选</button>
          </div>

          <div class="glossary-groups">
            {glossaryCategories.map((category) => (
              <section
                class="glossary-group"
                data-filter-group
                id={'glossary-' + category.id}
                aria-labelledby={'glossary-' + category.id + '-title'}
              >
                <div class="glossary-group__head">
                  <h2 id={'glossary-' + category.id + '-title'}>{category.name}</h2>
                  <span>{categoryCount(category.id)} 条</span>
                </div>
                <p class="glossary-group__desc">{category.description}</p>

                <div class="glossary-grid">
                  {terms.filter((term) => term.data.category === category.id).map((term) => {
                    const searchText = [
                      term.data.term,
                      term.data.en,
                      ...term.data.aliases,
                      term.data.definition,
                      term.data.example,
                      category.name,
                    ].join(' ').toLowerCase();
                    return (
                      <article
                        class="glossary-term"
                        id={term.id}
                        data-filter-card
                        data-category={term.data.category}
                        data-search={searchText}
                      >
                        <div class="glossary-term__head">
                          <h3>
                            <a href={'/glossary/' + term.id + '/'}>
                              {term.data.term}<span>{term.data.en}</span>
                            </a>
                          </h3>
                        </div>
                        <p class="glossary-term__definition">{term.data.definition}</p>
                        <details class="glossary-term__details">
                          <summary>例子与别名</summary>
                          <p class="glossary-term__example"><span>例子</span>{term.data.example}</p>
                          {term.data.aliases.length > 0 && (
                            <p class="glossary-term__aliases">也常叫：{term.data.aliases.join(' / ')}</p>
                          )}
                        </details>
                        <a class="glossary-term__more" href={'/glossary/' + term.id + '/'}>
                          查看详解
                          <Icon name="arrow-right" size={13} />
                        </a>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>

          <div class="empty-state" data-empty-state hidden>
            <Icon name="search" size={28} />
            <h2>没有找到匹配的术语</h2>
            <p>换个更短的关键词，或点击「清除筛选」查看全部。</p>
          </div>
        </div>
      </div>
      )}

      <div class="page-meta">
        {lastUpdated ? (
          <span><Icon name="clock" size={14} />最后更新：{lastUpdated}</span>
        ) : (
          <span><Icon name="clock" size={14} />内容准备中 · 欢迎共建</span>
        )}
        <a href={repository.url + '/tree/' + repository.branch + '/src/content/glossary'} target="_blank" rel="noopener noreferrer">
          <Icon name="pen" size={14} />在 GitHub 编辑术语表
          <Icon name="arrow-up-right" size={13} />
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initFilter } from '../../scripts/filter';
  initFilter();
</script>
